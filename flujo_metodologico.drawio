  <diagram id="diag_metodologia_oficial_v2" name="Flujo Metodológico Oficial (SCOP - Osinergmin)">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1855" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_fase1" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="35" y="40" width="285" height="960" as="geometry" />
        </mxCell>
        <mxCell id="h_fase1" value="Fase 1 · Adquisición de datos y panel diario&lt;br&gt;&lt;span style=&quot;font-weight:400;font-size:9.5px;color:#475569;&quot;&gt;(Sección 3.1)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;fontFamily=Segoe UI,Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;align=center;" parent="1" vertex="1">
          <mxGeometry x="45" y="55" width="265" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n_1_1" value="&lt;b&gt;Registro de Precios SCOP&lt;/b&gt;&lt;br&gt;&#10;• Fuente oficial: Osinergmin&lt;br&gt;&#10;• 21 libros Excel brutos&lt;br&gt;&#10;• &lt;b&gt;15 163 031&lt;/b&gt; reportes de precios&lt;br&gt;&#10;• Período: marzo 2020 – setiembre 2026" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.2;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="45" y="120" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_1_2" value="&lt;b&gt;Seudonimización de Identidad&lt;/b&gt;&lt;br&gt;&#10;• Algoritmo: SHA-256 con clave secreta&lt;br&gt;&#10;• Aplicado sobre: Registro de Hidrocarburos&lt;br&gt;&#10;• Eliminación estricta de: RUC, razón social y dirección (Ley 29733)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="45" y="260" width="265" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n_1_3" value="&lt;b&gt;Selección y Limpieza de Datos&lt;/b&gt;&lt;br&gt;&#10;• Filtro: Venta al público minorista&lt;br&gt;&#10;• 5 combustibles masivos seleccionados&lt;br&gt;&#10;• Marca principal en GLP envasado&lt;br&gt;&#10;• Depuración: duplicados, nulos y precios fuera de [0,5–2,0] × mediana mensual&lt;br&gt;&#10;• &lt;b&gt;Resultado:&lt;/b&gt; 11 718 907 reportes&lt;br&gt;&#10;  (24 771 establecimientos activos)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="45" y="395" width="265" height="155" as="geometry" />
        </mxCell>
        <mxCell id="n_1_4" value="&lt;b&gt;Reconstrucción de Panel Diario&lt;/b&gt;&lt;br&gt;&#10;• Malla cartesiana continua:&lt;br&gt;&#10;  [Establecimiento × Combustible × Día]&lt;br&gt;&#10;• Arrastre de precio: &lt;i&gt;forward-fill&lt;/i&gt; ≤ 60 días sin nuevo reporte (Ec. 1)&lt;br&gt;&#10;• &lt;b&gt;Total: 39,6 millones de filas&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="45" y="580" width="265" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_1_5" value="&lt;b&gt;Análisis Exploratorio&lt;/b&gt;&lt;br&gt;&#10;• &lt;b&gt;95,35 %&lt;/b&gt; de días sin cambio de precio&lt;br&gt;&#10;• Fuerte inercia temporal observada&lt;br&gt;&#10;• Heterogeneidad por combustible, mes calendario y región geográfica" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1;dashed=1;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=9.5;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="45" y="740" width="265" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c_fase2" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="335" y="40" width="285" height="960" as="geometry" />
        </mxCell>
        <mxCell id="h_fase2" value="Fase 2 · Variable objetivo y predictoras&lt;br&gt;&lt;span style=&quot;font-weight:400;font-size:9.5px;color:#475569;&quot;&gt;(Sección 3.2)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;fontFamily=Segoe UI,Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;align=center;" parent="1" vertex="1">
          <mxGeometry x="345" y="55" width="265" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n_2_1" value="&lt;b&gt;Variable Objetivo (Etiqueta Binaria)&lt;/b&gt;&lt;br&gt;&#10;• Pregunta: ¿Cambia el precio en los próximos 5 días calendario? (Ec. 2)&lt;br&gt;&#10;• Horizonte principal: &lt;i&gt;H&lt;/i&gt; = 5 días&lt;br&gt;&#10;  (Semana laboral de supervisión)&lt;br&gt;&#10;• Análisis de robustez: horizontes alternativos evaluados con &lt;i&gt;H&lt;/i&gt; = 3 y 7 días" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="345" y="160" width="265" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n_2_2" value="&lt;b&gt;Vector de 29 Variables Predictoras&lt;/b&gt;&lt;br&gt;&#10;(Estructuradas en 4 dimensiones):&lt;br&gt;&#10;1. &lt;b&gt;Historial propio:&lt;/b&gt; días sin cambio, n_cambios (7, 14, 28, 90d), magnitud, anomalia_espera (hazard rate).&lt;br&gt;&#10;2. &lt;b&gt;Presión de mercado:&lt;/b&gt; precio actual, desv. y percentil respecto al país.&lt;br&gt;&#10;3. &lt;b&gt;Competencia territorial:&lt;/b&gt; % que cambia y desv. en provincia y departamento.&lt;br&gt;&#10;4. &lt;b&gt;Establecimiento y calendario:&lt;/b&gt; tipo de combustible, actividad, día de semana y mes." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="345" y="340" width="265" height="205" as="geometry" />
        </mxCell>
        <mxCell id="n_2_3" value="¿Las 3 variables nuevas&lt;br&gt;mejoran el AUC en 2025?&lt;br&gt;(Wilcoxon pareado)" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontFamily=Segoe UI,Arial;fontSize=9.5;fontStyle=1;fontColor=#0F172A;align=center;" parent="1" vertex="1">
          <mxGeometry x="360" y="585" width="235" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_2_4" value="&lt;b&gt;Vector Analítico Definitivo&lt;/b&gt;&lt;br&gt;&#10;• Sí: Entran &lt;code&gt;anomalia_espera&lt;/code&gt;, &lt;code&gt;provincia_pct_cambia&lt;/code&gt; y &lt;code&gt;desv_provincia_pct&lt;/code&gt; (&lt;i&gt;p&lt;/i&gt; = 0,0005)&lt;br&gt;&#10;• Matriz &lt;b&gt;X&lt;/b&gt; ∈ ℝ&lt;sup&gt;N × 29&lt;/sup&gt; sin colinealidad destructiva en gradientes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="345" y="735" width="265" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c_fase3" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="635" y="40" width="285" height="960" as="geometry" />
        </mxCell>
        <mxCell id="h_fase3" value="Fase 3 · Validación y control de fuga&lt;br&gt;&lt;span style=&quot;font-weight:400;font-size:9.5px;color:#475569;&quot;&gt;(Sección 3.3)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;fontFamily=Segoe UI,Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;align=center;" parent="1" vertex="1">
          <mxGeometry x="645" y="55" width="265" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n_3_1" value="&lt;b&gt;Partición Ciega de Grifos&lt;/b&gt;&lt;br&gt;&#10;• &lt;b&gt;30 % de establecimientos&lt;/b&gt; apartado al azar antes de entrenar ningún modelo&lt;br&gt;&#10;• Jamás participa en entrenamiento&lt;br&gt;&#10;• Reservado para prueba ciega de generalización en casos 'nunca vistos'" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="645" y="120" width="265" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n_3_2" value="&lt;b&gt;Validación Temporal por Origen Móvil&lt;/b&gt;&lt;br&gt;&#10;• 12 bloques mensuales continuos (2025)&lt;br&gt;&#10;• Entrenamiento rodante: &lt;b&gt;182 días&lt;/b&gt; (~6m)&lt;br&gt;&#10;• &lt;b&gt;Purga temporal de 6 días&lt;/b&gt; (&lt;i&gt;H&lt;/i&gt; + 1, Ec. 3) previa a cada mes evaluado&lt;br&gt;&#10;• Blindaje absoluto contra fuga de futuro" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="645" y="265" width="265" height="135" as="geometry" />
        </mxCell>
        <mxCell id="n_3_3" value="&lt;b&gt;Evaluación de Balanceo de Clases&lt;/b&gt;&lt;br&gt;&#10;• Comparación de 8 métodos empíricos&lt;br&gt;&#10;• Regla de decisión de 4 métricas:&lt;br&gt;&#10;  &lt;b&gt;Ganador: Ninguno&lt;/b&gt; (distribución natural)&lt;br&gt;&#10;• Corrección analítica de probabilidades de Dal Pozzolo et al. (Ec. 4)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="645" y="425" width="265" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_3_4" value="&lt;b&gt;Tamaño Muestral de Entrenamiento&lt;/b&gt;&lt;br&gt;&#10;• Curva de aprendizaje: 50k a 1M de filas&lt;br&gt;&#10;• Selección parsimoniosa: &lt;b&gt;300 000 filas&lt;/b&gt; por bloque para contrastar ensambles" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="645" y="580" width="265" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n_3_5" value="&lt;b&gt;Prueba Negativa de Control&lt;/b&gt;&lt;br&gt;&#10;• Etiquetas permutadas al azar&lt;br&gt;&#10;• AUC resultante ≈ 0,489 (centrado en 0,5)&lt;br&gt;&#10;• Certifica ausencia de fuga espuria" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1;dashed=1;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=9.5;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="645" y="705" width="265" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n_3_6" value="AÑO 2026: RESERVADO FUERA DE MUESTRA&lt;br&gt;&#10;&lt;span style=&quot;font-weight:400;font-size:9px;&quot;&gt;Datos sellados fuera de muestra.&lt;br&gt;Se evalúan una sola vez al final del estudio.&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.2;align=center;spacing=6;fontFamily=Segoe UI,Arial;fontSize=9.5;fontStyle=1;fontColor=#475569;" parent="1" vertex="1">
          <mxGeometry x="645" y="835" width="265" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c_fase4" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="935" y="40" width="285" height="960" as="geometry" />
        </mxCell>
        <mxCell id="h_fase4" value="Fase 4 · Modelos base y ensambles&lt;br&gt;&lt;span style=&quot;font-weight:400;font-size:9.5px;color:#475569;&quot;&gt;(Sección 3.4)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;fontFamily=Segoe UI,Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;align=center;" parent="1" vertex="1">
          <mxGeometry x="945" y="55" width="265" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n_bm_cb" value="&lt;b&gt;CatBoost&lt;/b&gt;&lt;br&gt;• Árboles simétricos&lt;br&gt;• Reg. L2 nativa" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;align=left;spacing=5;fontFamily=Segoe UI,Arial;fontSize=9.5;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="945" y="120" width="127" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_bm_lgb" value="&lt;b&gt;LightGBM&lt;/b&gt;&lt;br&gt;• Crecimiento leaf-wise&lt;br&gt;• Histogramas estándar" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;align=left;spacing=5;fontFamily=Segoe UI,Arial;fontSize=9.5;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="1082" y="120" width="127" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_bm_xgb" value="&lt;b&gt;XGBoost&lt;/b&gt;&lt;br&gt;• Crecimiento depth-wise&lt;br&gt;• Penalización L1/L2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;align=left;spacing=5;fontFamily=Segoe UI,Arial;fontSize=9.5;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="945" y="210" width="127" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_bm_rf" value="&lt;b&gt;Random Forest&lt;/b&gt;&lt;br&gt;• 300 árboles independientes&lt;br&gt;• Promedio por bagging" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;align=left;spacing=5;fontFamily=Segoe UI,Arial;fontSize=9.5;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="1082" y="210" width="127" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_4_2" value="&lt;b&gt;Espacio de 39 Ensambles (Tabla 2)&lt;/b&gt;&lt;br&gt;&#10;• 10 familias metodológicas evaluadas:&lt;br&gt;&#10;  Votación (dura, suave, ponderada, rangos), Bagging, Boosting metamodelo, Stacking lineal (clásico, L1, L2, ElasticNet), Stacking no negativo, Stacking no lineal, Blending, Selección Caruana, Mezcla de expertos y STJC.&lt;br&gt;&#10;• Evaluados en 2 modalidades: partición por grifo y partición temporal (1 mes)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="945" y="320" width="265" height="175" as="geometry" />
        </mxCell>
        <mxCell id="n_4_3" value="Regla de Selección Multicriterio:&lt;br&gt;&#10;1. Supera a individuales en más métricas (4 de 4)&lt;br&gt;&#10;2. Mejor posición media consolidada&lt;br&gt;&#10;3. Mayor AUC" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontFamily=Segoe UI,Arial;fontSize=9.5;fontStyle=1;fontColor=#0F172A;align=center;" parent="1" vertex="1">
          <mxGeometry x="955" y="530" width="245" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_4_4" value="&lt;b&gt;Ensamble Ganador: Votación Suave&lt;/b&gt;&lt;br&gt;&#10;• Promedio simple parsimonioso (Ec. 5):&lt;br&gt;&#10;  &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;final&lt;/sub&gt; = ¼ (&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Cat&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Lgb&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Xgb&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;RF&lt;/sub&gt;)&lt;br&gt;&#10;• &lt;b&gt;Récord de AUC: 0,7355&lt;/b&gt; (12 bloques 2025)&lt;br&gt;&#10;• Cero parámetros que sobreajustar&lt;br&gt;&#10;• &lt;b&gt;Algoritmo seleccionado para producción&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;strokeWidth=1.8;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="945" y="700" width="265" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c_fase5" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="1235" y="40" width="285" height="960" as="geometry" />
        </mxCell>
        <mxCell id="h_fase5" value="Fase 5 · Método propuesto STJC&lt;br&gt;&lt;span style=&quot;font-weight:400;font-size:9.5px;color:#475569;&quot;&gt;(Sección 3.5 · Aporte nuclear)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;fontFamily=Segoe UI,Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;align=center;" parent="1" vertex="1">
          <mxGeometry x="1245" y="55" width="265" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n_5_1" value="&lt;div style=&quot;font-size:11px;font-weight:800;color:#581C87;border-bottom:1.5px solid #7C3AED;padding-bottom:3px;margin-bottom:6px;&quot;&gt;&#10;STJC: Stacking Temporal Jerárquico con Contracción (Aporte Metodológico)&lt;/div&gt;&#10;Arquitectura de meta-aprendizaje diseñada para resolver colinealidad extrema (ρ &gt; 0,91):&lt;br&gt;&lt;br&gt;&#10;1. &lt;b&gt;Multiventana temporal:&lt;/b&gt; 3 meses de historia en meta-entrenamiento.&lt;br&gt;&#10;2. &lt;b&gt;Restricción convexa:&lt;/b&gt; &lt;i&gt;w&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; ≥ 0, ∑ &lt;i&gt;w&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; = 1 (elimina pesos negativos inestables).&lt;br&gt;&#10;3. &lt;b&gt;Contracción analítica:&lt;/b&gt; penalización hacia pesos iguales con λ elegido por AUC del mes previo entre {0; 0,001; …; ∞} (Ec. 7).&lt;br&gt;&#10;4. &lt;b&gt;Ponderación jerárquica:&lt;/b&gt; pesos por combustible (solo si mejoran).&lt;br&gt;&#10;5. &lt;b&gt;Bagging temporal:&lt;/b&gt; promediado de ventanas para mitigación de varianza.&lt;br&gt;&#10;6. &lt;b&gt;Ablación pieza por pieza:&lt;/b&gt; documenta la ganancia incremental de cada módulo.&lt;br&gt;&lt;br&gt;&#10;&lt;b&gt;Récords absolutos del estudio:&lt;/b&gt;&lt;br&gt;&#10;• Precisión@100 = &lt;b&gt;62,51 %&lt;/b&gt; | Precisión@50 = &lt;b&gt;70,23 %&lt;/b&gt;&lt;br&gt;&#10;• Brier Score = &lt;b&gt;0,1031&lt;/b&gt; (mejor calibración)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=2;shadow=1;align=left;spacing=8;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#1E1B4B;" parent="1" vertex="1">
          <mxGeometry x="1245" y="260" width="265" height="320" as="geometry" />
        </mxCell>
        <mxCell id="n_5_note" value="&lt;b&gt;Relación Metodológica&lt;/b&gt;&lt;br&gt;&#10;El STJC es uno de los &lt;b&gt;39 candidatos evaluados&lt;/b&gt; dentro del espacio de ensambles de la Fase 4.&lt;br&gt;&#10;Superó al mejor individual en las 4 métricas cardinales (4 de 4)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1;dashed=1;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=9.5;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="1245" y="600" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_fase6" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="1535" y="40" width="285" height="960" as="geometry" />
        </mxCell>
        <mxCell id="h_fase6" value="Fase 6 · Evaluación e interpretabilidad&lt;br&gt;&lt;span style=&quot;font-weight:400;font-size:9.5px;color:#475569;&quot;&gt;(Sección 3.6)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;fontFamily=Segoe UI,Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;align=center;" parent="1" vertex="1">
          <mxGeometry x="1545" y="55" width="265" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n_6_1" value="&lt;b&gt;Métricas y Auditoría Estadística&lt;/b&gt;&lt;br&gt;&#10;• Métricas operativas: AUC, &lt;i&gt;p@50&lt;/i&gt;, &lt;i&gt;p@100&lt;/i&gt;, &lt;i&gt;p@250&lt;/i&gt; y 10 por región, Brier Score.&lt;br&gt;&#10;• Prueba pareada de Wilcoxon con corrección estricta de Holm-Bonferroni (Tabla 3):&lt;br&gt;&#10;  Significancia confirmada en 16 de 16 comparaciones frente a modelos base (&lt;i&gt;p&lt;/i&gt; &lt; 0,01)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="1545" y="120" width="265" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_6_2" value="&lt;b&gt;Prueba Prospectiva 2026 (Real)&lt;/b&gt;&lt;br&gt;&#10;• Evaluación continua de &lt;b&gt;262 días&lt;/b&gt; (ene–set 2026)&lt;br&gt;&#10;• Reentrenamiento trimestral del ensamble&lt;br&gt;&#10;• &lt;b&gt;78,39 % de aciertos reales&lt;/b&gt; en el Top 100 diario (20 539 aciertos en 26 200 visitas)&lt;br&gt;&#10;• Superior a reglas heurísticas (`n_cambios_28`, `n_cambios_90`) y al modelo congelado&lt;br&gt;&#10;• Generalización en nunca vistos (AUC = 0,7439) y robustez en horizontes de 3 y 7 días" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="1545" y="275" width="265" height="185" as="geometry" />
        </mxCell>
        <mxCell id="n_6_3" value="&lt;b&gt;Interpretabilidad Algorítmica&lt;/b&gt;&lt;br&gt;&#10;• Importancia global por permutación de variables (Sección 19)&lt;br&gt;&#10;• Explicaciones locales y globales con valores SHAP (TreeSHAP)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.2;shadow=0;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="1545" y="485" width="265" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n_6_4" value="&lt;b&gt;Sistema de Apoyo a la Fiscalización&lt;/b&gt;&lt;br&gt;&#10;• Generación diaria de listas Top-&lt;i&gt;K&lt;/i&gt; por región&lt;br&gt;&#10;• Razones explicativas por establecimiento&lt;br&gt;&#10;• Comprobación de precio frente al reporte SCOP" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;strokeWidth=1.8;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=10;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="1545" y="605" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_6_5" value="&lt;b&gt;Validación con Expertos (Método Delphi)&lt;/b&gt;&lt;br&gt;&#10;• Panel de supervisores y especialistas de hidrocarburos de Osinergmin&lt;br&gt;&#10;• Evaluación de viabilidad operativa y utilidad" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1;dashed=1;align=left;spacing=6;fontFamily=Segoe UI,Arial;fontSize=9.5;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="1545" y="740" width="265" height="95" as="geometry" />
        </mxCell>
