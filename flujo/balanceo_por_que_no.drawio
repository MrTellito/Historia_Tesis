        <mxCell id="t41" vertex="1" parent="1" value="Regla teórica: aciertos esperados = suma de las probabilidades seleccionadas. Supuesto: igual costo y valor por caso." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;">
