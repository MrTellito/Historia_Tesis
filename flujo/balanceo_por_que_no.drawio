        <mxCell id="t32" vertex="1" parent="1" value="EDA 2025: ≈13,1 % de positivos. El esquema de puntos redondea a 13 %. Las probabilidades A–F son ilustrativas; en la tesis se usa K = 100." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;">
