        <mxCell id="t40" vertex="1" parent="1" value="El caso C entra aunque su probabilidad sea 40 %: importa su puesto, no superar un umbral fijo de 50 %." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#000000;strokeColor=none;fillColor=none;">
