<mxfile host="Electron"><diagram id="balanceo_v6" name="Balanceo en la tesis"><mxGraphModel dx="605" dy="990" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="605" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;1 · Con qué aprende el modelo cada mes de 2025&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F2937;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="12" y="8" width="578" height="22" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;Muestra de entrenamiento: 300 000 filas&lt;/b&gt;&lt;br&gt;De los 182 días previos al mes evaluado. Cada fila = establecimiento × combustible × día, con 29 variables y la respuesta: ¿cambia el precio en los próximos 5 días?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12" y="40" width="578" height="52" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;13 %&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#FFFFFF;fillColor=#0F7C7A;strokeColor=#0F7C7A;" vertex="1" parent="1"><mxGeometry x="12" y="100" width="75" height="26" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;87 %&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1F2937;fillColor=#CBD2D9;strokeColor=#CBD2D9;" vertex="1" parent="1"><mxGeometry x="87" y="100" width="503" height="26" as="geometry"/></mxCell><mxCell id="v5" value="≈ 39 000 filas «sí cambia»  ·  ≈ 261 000 filas «no cambia»  (tasa de 2025: 13,1 %)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="12" y="128" width="578" height="18" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;2 · Los 8 métodos (solo en el entrenamiento; el mes evaluado queda real)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F2937;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="12" y="160" width="578" height="22" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Cambian el peso de casos reales&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#FFFFFF;fillColor=#0F7C7A;strokeColor=#0F7C7A;" vertex="1" parent="1"><mxGeometry x="12" y="192" width="186" height="26" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Botan mucha información&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#FFFFFF;fillColor=#B86E0A;strokeColor=#B86E0A;" vertex="1" parent="1"><mxGeometry x="208" y="192" width="186" height="26" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Inventan casos&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#FFFFFF;fillColor=#B23A3A;strokeColor=#B23A3A;" vertex="1" parent="1"><mxGeometry x="404" y="192" width="186" height="26" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Pesos&lt;/b&gt;&lt;br&gt;Cada «sí» cuenta ≈ 6,7 veces más" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E6F2F2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12" y="224" width="186" height="52" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Sobremuestreo&lt;/b&gt;&lt;br&gt;Copia ≈ 222 000 «sí» reales" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E6F2F2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12" y="281" width="186" height="38" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Submuestreo 1:3&lt;/b&gt;&lt;br&gt;Bota ≈ 144 000 «no» al azar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E6F2F2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12" y="324" width="186" height="38" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Tomek&lt;/b&gt;&lt;br&gt;Bota pocos «no» pegados a un «sí»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E6F2F2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12" y="367" width="186" height="52" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Submuestreo 1:1&lt;/b&gt;&lt;br&gt;Bota ≈ 222 000 «no»: el 85 % de los grifos que no cambiaron" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#B86E0A;fillColor=#FDF3E4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="208" y="224" width="186" height="66" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;SMOTENC&lt;/b&gt;&lt;br&gt;Crea ≈ 222 000 «sí» mezclando dos casos vecinos del mismo combustible" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#B23A3A;fillColor=#FBECEC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="404" y="224" width="186" height="66" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;ADASYN&lt;/b&gt;&lt;br&gt;Igual, pero inventa más donde el caso es dudoso" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#B23A3A;fillColor=#FBECEC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="404" y="295" width="186" height="52" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;3 · Qué pasa al cruzarse con nuestros datos&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F2937;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="12" y="438" width="578" height="22" as="geometry"/></mxCell><mxCell id="v18" value="Hay ≈ 39 000 «sí» por mes: no son escasos.&lt;br&gt;Y la tarea es ordenar a quién visitar." style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.04;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#F3F4F6;spacing=6;" vertex="1" parent="1"><mxGeometry x="12" y="470" width="186" height="86" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Suben las probabilidades de todos, pero el orden casi no cambia&lt;/b&gt;&lt;br&gt;Hay que corregir la escala a la salida (Dal Pozzolo, Ec. 4)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E6F2F2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12" y="572" width="186" height="94" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v18" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v21" value="Los «no» enseñan cómo es un grifo estable." style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.04;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#F3F4F6;spacing=6;" vertex="1" parent="1"><mxGeometry x="208" y="470" width="186" height="86" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;El modelo pierde esa información&lt;/b&gt;&lt;br&gt;Distingue peor a los grifos que no van a cambiar." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#B86E0A;fillColor=#FDF3E4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="208" y="572" width="186" height="94" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v21" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v24" value="Las variables están ligadas entre sí y al día (días sin cambio, cambios en 7 días, % del mercado que cambia)." style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.04;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#F3F4F6;spacing=6;" vertex="1" parent="1"><mxGeometry x="404" y="470" width="186" height="86" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;Aparecen grifos imposibles&lt;/b&gt;&lt;br&gt;Ej.: 21 días sin cambio y, a la vez, 2 cambios en la última semana; o un «% del mercado» de un día que no existió." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#B23A3A;fillColor=#FBECEC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="404" y="572" width="186" height="94" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v24" target="v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v27" value="&lt;b&gt;4 · Resultado en los 12 meses de 2025 (LightGBM; «ninguno»: AUC 0,7326 · p@100 61,5 %)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F2937;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="12" y="680" width="578" height="22" as="geometry"/></mxCell><mxCell id="v28" value="&lt;b&gt;Empate&lt;/b&gt;&lt;br&gt;AUC 0,7323–0,7327&lt;br&gt;p@100 61,2–61,5 %&lt;br&gt;Superan a «ninguno» en 4 a 7 de 12 meses" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#FFFFFF;strokeWidth=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="12" y="712" width="186" height="80" as="geometry"/></mxCell><mxCell id="v29" value="&lt;b&gt;Peor&lt;/b&gt;&lt;br&gt;AUC 0,7318&lt;br&gt;p@100 60,3 %" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#B86E0A;fillColor=#FFFFFF;strokeWidth=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="208" y="712" width="186" height="80" as="geometry"/></mxCell><mxCell id="v30" value="&lt;b&gt;Mucho peor&lt;/b&gt;&lt;br&gt;AUC 0,6983 y 0,6911&lt;br&gt;p@100 49,4 % y 42,8 %&lt;br&gt;Pierden los 12 meses" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#B23A3A;fillColor=#FFFFFF;strokeWidth=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="404" y="712" width="186" height="80" as="geometry"/></mxCell><mxCell id="v31" value="Regla fijada antes:&lt;br&gt;mejor posición media&lt;br&gt;en las 4 métricas" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="32" y="812" width="200" height="96" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v28" target="v31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105.0" y="808"/><mxPoint x="132.0" y="808"/></Array></mxGeometry></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v29" target="v31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="301.0" y="808"/><mxPoint x="132.0" y="808"/></Array></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v30" target="v31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="497.0" y="808"/><mxPoint x="132.0" y="808"/></Array></mxGeometry></mxCell><mxCell id="v35" value="&lt;b&gt;Gana «ninguno»&lt;/b&gt;&lt;br&gt;Posición media 2,50 (1.º de 8)&lt;br&gt;2.ª ronda con los 4 modelos: 1,75 (1.º de 4)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E8F3EC;strokeWidth=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="262" y="827.0" width="328" height="66" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v31" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v37" value="&lt;b&gt;Modelo final: datos tal como son&lt;/b&gt;&lt;br&gt;Sin balanceo y sin corrección de probabilidades. Es la opción más simple y la que mejor ordena en nuestros datos." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#1F2937;fillColor=#FFFFFF;strokeWidth=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="12" y="922" width="578" height="52" as="geometry"/></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7163;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v35" target="v37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>