        </mxCell>
        <mxCell id="t81" vertex="1" parent="example3" value="Random Forest: 20% · peso 10%" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=26;fontStyle=1;fontColor=#000000;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="20" y="16" width="430" height="34" />
        </mxCell>
        <mxCell id="t82" vertex="1" parent="formula" value="COMBINACIÓN EN ESCALA LOGIT" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=26;fontStyle=1;fontColor=#000000;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="20" y="16" width="630" height="34" />
        </mxCell>
        <mxCell id="t83" vertex="1" parent="formula" value="1. Convertir cada p: L = ln[p / (1 − p)]." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="20" y="62" width="630" height="30" />
        </mxCell>
        <mxCell id="t84" vertex="1" parent="formula" value="2. Sumar: z = 0,4 L(CB) + 0,3 L(LGB)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="20" y="92" width="630" height="30" />
        </mxCell>
        <mxCell id="t85" vertex="1" parent="formula" value="+ 0,2 L(XGB) + 0,1 L(RF)." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="20" y="122" width="630" height="30" />
        </mxCell>
        <mxCell id="t86" vertex="1" parent="formula" value="3. Volver a probabilidad: p = 1 / (1 + exp(−z))." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#000000;strokeColor=none;fillColor=none;">
