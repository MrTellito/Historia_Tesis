<mxfile host="65bd71144e" modified="2026-10-12T12:40:00.000Z" agent="Antigravity/2.0" version="21.0.0" type="device"><diagram id="diag_arquitectura_mlops" name="Arquitectura Metodológica MLOps (Artículo)"><mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2460" pageHeight="2140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n_101" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif;&quot;&gt;&lt;div style=&quot;font-size: 21px; font-weight: 800; color: #0F172A; text-transform: uppercase; letter-spacing: 0.5px;&quot;&gt;Arquitectura Metodológica y Flujo del Sistema de Priorización SCOP (Osinergmin)&lt;/div&gt;&lt;div style=&quot;font-size: 13px; font-weight: 500; color: #475569; margin-top: 4px;&quot;&gt;Pipeline End-to-End: Desde la Ingesta de Datos Transaccionales Masivos hasta la Fiscalización Inteligente Basada en Riesgo&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="20" width="2340" height="75" as="geometry" /></mxCell><mxCell id="n_102" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#3B82F6;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="115" width="2340" height="245" as="geometry" /></mxCell><mxCell id="n_103" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; font-weight: 800; color: #FFFFFF;&quot;&gt;CAPA A: FUENTES DE DATOS REGULATORIAS &amp; PIPELINE DE INGESTA PRIMARIA&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#3B82F6;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="101" width="560" height="28" as="geometry" /></mxCell><mxCell id="n_104" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 12px;&quot;&gt;🗄️ BD SCOP Osinergmin&lt;/div&gt;&lt;div style=&quot;color: #334155; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Reportes de Precios&lt;/b&gt;&lt;br/&gt;• ~1.1 GB en bruto (2020–2026)&lt;br/&gt;• 15.1M registros transaccionales&lt;br/&gt;• 5 familias de combustibles&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="90" y="150" width="220" height="175" as="geometry" /></mxCell><mxCell id="n_105" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 12px;&quot;&gt;🗄️ BD Precios Mayoristas&lt;/div&gt;&lt;div style=&quot;color: #334155; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Costos Ex-Planta&lt;/b&gt;&lt;br/&gt;• Petroperú y Refinerías&lt;br/&gt;• Listas semanales mayoristas&lt;br/&gt;• Señal de costos upstream&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="340" y="150" width="220" height="175" as="geometry" /></mxCell><mxCell id="n_106" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 12px;&quot;&gt;🗄️ BD Macroeconómica&lt;/div&gt;&lt;div style=&quot;color: #334155; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Señales de Mercado&lt;/b&gt;&lt;br/&gt;• Tipo de cambio USD/PEN (BCRP)&lt;br/&gt;• Cotización WTI / Brent&lt;br/&gt;• Inflación y estacionalidad&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="590" y="150" width="220" height="175" as="geometry" /></mxCell><mxCell id="n_107" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #3B82F6; padding-bottom: 3px;&quot;&gt;📥 A.1 Extracción &amp; Validación de Esquema&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;• Conexión por lotes al repositorio SCOP.&lt;br/&gt;• Tipado estricto de campos numéricos y fechas.&lt;br/&gt;• Filtrado de registros incompletos o cancelados.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="860" y="160" width="340" height="155" as="geometry" /></mxCell><mxCell id="n_108" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #3B82F6; padding-bottom: 3px;&quot;&gt;🔒 A.2 Seudonimización Criptográfica&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;• Hash criptográfico &lt;b&gt;HMAC-SHA256 con sal&lt;/b&gt; sobre el código de estación (&lt;code&gt;idn&lt;/code&gt;).&lt;br/&gt;• Preserva la continuidad de las series temporales por estación.&lt;br/&gt;• Garantiza secreto comercial y seguridad de datos.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1250" y="160" width="340" height="155" as="geometry" /></mxCell><mxCell id="n_109" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #3B82F6; padding-bottom: 3px;&quot;&gt;🧹 A.3 Filtros de Integridad &amp; Calidad&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;• Detección y remoción de errores tipográficos en precio.&lt;br/&gt;• Control de monotonicidad temporal (sin saltos al futuro).&lt;br/&gt;• Generación de log de auditoría de ingesta limpia.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1640" y="160" width="340" height="155" as="geometry" /></mxCell><mxCell id="n_110" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 11.5px;&quot;&gt;🗄️ Staging Limpio&lt;/div&gt;&lt;div style=&quot;color: #334155; margin-top: 4px; font-size: 10px;&quot;&gt;Transacciones limpias seudonimizadas en formato Parquet&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="2030" y="160" width="210" height="155" as="geometry" /></mxCell><mxCell id="e_111" value="Extracción" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#3B82F6;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="n_104" target="n_107"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_112" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#3B82F6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_105" target="n_107"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_113" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#3B82F6;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="n_106" target="n_107"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_114" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#3B82F6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_107" target="n_108"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_115" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#3B82F6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_108" target="n_109"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#2563EB;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_109" target="n_110"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_117" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0D9488;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="390" width="2340" height="360" as="geometry" /></mxCell><mxCell id="n_118" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; font-weight: 800; color: #FFFFFF;&quot;&gt;CAPA B: RECONSTRUCCIÓN DEL PANEL TEMPORAL CONTINUO &amp; INGENIERÍA DE 29 CARACTERÍSTICAS&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#0D9488;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="376" width="690" height="28" as="geometry" /></mxCell><mxCell id="n_119" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #0F766E; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #0D9488; padding-bottom: 3px;&quot;&gt;📊 B.1 Reconstrucción del Panel Continuo&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• &lt;b&gt;Malla Cartesiana Completa:&lt;/b&gt; &lt;code&gt;[Grifo × Combustible × Día]&lt;/code&gt; (~39.1M obs).&lt;br/&gt;• &lt;b&gt;Regla Forward-Fill:&lt;/b&gt; Si hoy no reportó, se imputa el último precio oficial vigente.&lt;br/&gt;• Modela la realidad física: el combustible sigue vendiéndose al precio del tótem.&lt;br/&gt;• Monitoreo continuo de &lt;b&gt;~19,292 grifos activos&lt;/b&gt; diarios a nivel nacional.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="90" y="435" width="340" height="270" as="geometry" /></mxCell><mxCell id="n_120" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #0F766E; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #0D9488; padding-bottom: 3px;&quot;&gt;🎯 B.2 Etiquetado Objetivo &amp; Purga Temporal&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• &lt;b&gt;Variable Binaria Objetivo:&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 4px 0; background: #F0FDFA; padding: 4px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #0F766E;&quot;&gt;&lt;i&gt;Y&lt;sub&gt;i,t&lt;/sub&gt;&lt;/i&gt; = 1 si el precio cambia en horizonte &lt;i&gt;H&lt;/i&gt; = 5 días; 0 en caso contrario&lt;/div&gt;• &lt;b&gt;Purga Obligatoria de 5 Días:&lt;/b&gt; Brecha ciega de seguridad entre el fin del bloque de entrenamiento y el inicio de evaluación.&lt;br/&gt;• Elimina 100% de solapamiento del target (cero filtración temporal).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="465" y="435" width="355" height="270" as="geometry" /></mxCell><mxCell id="n_121" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #0F766E; font-size: 11.5px; border-bottom: 1px solid #14B8A6; padding-bottom: 2px; margin-bottom: 4px;&quot;&gt;📈 Dinámica &amp; Inercia (10 vars)&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• &lt;code&gt;dias_desde_ult_cambio&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;n_cambios_7&lt;/code&gt;, &lt;code&gt;14&lt;/code&gt;, &lt;code&gt;28&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;var_precio_7d&lt;/code&gt;, &lt;code&gt;28d&lt;/code&gt; | &lt;code&gt;desv_est_28d&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Hazard rate ('despertador')&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#99F6E4;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="855" y="435" width="275" height="130" as="geometry" /></mxCell><mxCell id="n_122" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #0F766E; font-size: 11.5px; border-bottom: 1px solid #14B8A6; padding-bottom: 2px; margin-bottom: 4px;&quot;&gt;🏪 Competencia Local (8 vars)&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Δ&lt;i&gt;P&lt;/i&gt; = &lt;i&gt;P&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; − Mediana(Vecinos Cercanos)&lt;br/&gt;• &lt;code&gt;n_competidores_1km&lt;/code&gt;, &lt;code&gt;3km&lt;/code&gt;, &lt;code&gt;5km&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;dist_min_competidor&lt;/code&gt;&lt;br/&gt;• Percentil distrital y dispersión barrial&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#99F6E4;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="855" y="575" width="275" height="130" as="geometry" /></mxCell><mxCell id="n_123" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #0F766E; font-size: 11.5px; border-bottom: 1px solid #14B8A6; padding-bottom: 2px; margin-bottom: 4px;&quot;&gt;🛢️ Mayorista &amp; Macro (6 vars)&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Costo ex-planta Petroperú&lt;br/&gt;• &lt;code&gt;margen_bruto_estimado&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;delta_precio_planta_7d&lt;/code&gt;&lt;br/&gt;• Tipo de cambio USD/PEN | WTI&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#99F6E4;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="1155" y="435" width="275" height="130" as="geometry" /></mxCell><mxCell id="n_124" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #0F766E; font-size: 11.5px; border-bottom: 1px solid #14B8A6; padding-bottom: 2px; margin-bottom: 4px;&quot;&gt;🏢 Estructurales (5 vars)&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• &lt;code&gt;combustible_code&lt;/code&gt; (5 familias)&lt;br/&gt;• &lt;code&gt;actividad_code&lt;/code&gt; (Estación, Puesto)&lt;br/&gt;• Departamento / Región económica&lt;br/&gt;• Coordenadas UTM y clúster logístico&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#99F6E4;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="1155" y="575" width="275" height="130" as="geometry" /></mxCell><mxCell id="n_125" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #0F766E; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #0D9488; padding-bottom: 3px;&quot;&gt;🔬 B.3 Filtrado VIF &amp; Diagnóstico&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• &lt;b&gt;Factor de Inflación de Varianza:&lt;/b&gt; VIF &amp;lt; 5 en todas las variables continuas.&lt;br/&gt;• &lt;b&gt;Colinealidad Cruzada:&lt;/b&gt; Filtrado de correlación redundante par a par (|&lt;i&gt;r&lt;/i&gt;| &amp;lt; 0.85).&lt;br/&gt;• Asegura vector analítico óptimo sin degradación numérica de gradientes.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1465" y="435" width="320" height="270" as="geometry" /></mxCell><mxCell id="n_126" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #0F766E; font-size: 12px;&quot;&gt;🗄️ Feature Store&lt;/div&gt;&lt;div style=&quot;color: #334155; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Matriz de Características&lt;/b&gt;&lt;br/&gt;• Matriz &lt;b&gt;X&lt;/b&gt; ∈ ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt; × 29&lt;/sup&gt; predictores&lt;br/&gt;• Etiqueta binaria &lt;i&gt;Y&lt;sub&gt;i,t&lt;/sub&gt;&lt;/i&gt; ∈ {0, 1}&lt;br/&gt;• Formato Parquet particionado&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="1820" y="465" width="210" height="210" as="geometry" /></mxCell><mxCell id="n_127" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 6px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #0F766E; font-size: 11.5px;&quot;&gt;✅ 29 Predictores Validados&lt;/div&gt;&lt;div style=&quot;color: #475569; font-size: 10px; margin-top: 3px;&quot;&gt;Panel continuo sin fuga de futuro listo para entrenamiento&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#14B8A6;strokeWidth=1.5;dashed=1;" parent="1" vertex="1"><mxGeometry x="2065" y="520" width="220" height="100" as="geometry" /></mxCell><mxCell id="e_128" value="Panel Base" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0D9488;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n_110" target="n_119"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2135" y="375" /><mxPoint x="260" y="375" /></Array></mxGeometry></mxCell><mxCell id="e_129" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0D9488;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_119" target="n_120"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_130" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#14B8A6;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_120" target="n_121"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_131" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#14B8A6;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_120" target="n_122"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_132" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#14B8A6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_121" target="n_123"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_133" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#14B8A6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_122" target="n_124"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_134" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#0D9488;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="n_123" target="n_125"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#0D9488;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="n_124" target="n_125"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_136" value="29 Características" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0D9488;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_125" target="n_126"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_137" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0D9488;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_126" target="n_127"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_138" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#EA580C;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="780" width="2340" height="420" as="geometry" /></mxCell><mxCell id="n_139" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; font-weight: 800; color: #FFFFFF;&quot;&gt;CAPA C: EXPERIMENTACIÓN, PROTOCOLO TEMPORAL WALK-FORWARD &amp; MODELOS BASE (NIVEL 0)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C2410C;strokeColor=#EA580C;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="766" width="690" height="28" as="geometry" /></mxCell><mxCell id="n_140" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #C2410C; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #EA580C; padding-bottom: 3px;&quot;&gt;📅 C.1 Validación Walk-Forward (12 Bloques 2025)&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• &lt;b&gt;Ventana de Entrenamiento:&lt;/b&gt; 6 meses continuos rodantes (180 días).&lt;br/&gt;• &lt;b&gt;Purga Obligatoria de 5 Días:&lt;/b&gt; Brecha ciega de seguridad (&lt;i&gt;t&lt;/i&gt; a &lt;i&gt;t&lt;/i&gt;+5).&lt;br/&gt;• &lt;b&gt;Bloque de Evaluación Fuera de Muestra:&lt;/b&gt; 1 mes calendario evaluado día a día de forma estricta.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="90" y="825" width="330" height="330" as="geometry" /></mxCell><mxCell id="n_141" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #C2410C; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #EA580C; padding-bottom: 3px;&quot;&gt;⚖️ C.2 Submuestreo Balanceado 1:1&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;• Tasa base natural desbalanceada (11% a 37%).&lt;br/&gt;• Submuestreo aleatorio de la clase mayoritaria (negativos) a 1:1 en entrenamiento.&lt;br/&gt;• &lt;i&gt;N&lt;/i&gt; = 100,000 filas/bloque para convergencia rápida y estabilidad.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="455" y="825" width="350" height="155" as="geometry" /></mxCell><mxCell id="n_142" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #C2410C; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #EA580C; padding-bottom: 3px;&quot;&gt;📐 C.3 Calibración Analítica Dal Pozzolo&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;div style=&quot;text-align: center; margin: 3px 0; background: #FFF7ED; padding: 4px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #9A3412;&quot;&gt;logit(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;real&lt;/sub&gt;) = logit(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;sub&lt;/sub&gt;) − ln(β), &amp;nbsp; β = ȳ&lt;sub&gt;entreno&lt;/sub&gt; / ȳ&lt;sub&gt;real&lt;/sub&gt;&lt;/div&gt;• Restaura calibración real sin alterar ranking (AUC idéntico).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="455" y="1000" width="350" height="155" as="geometry" /></mxCell><mxCell id="n_143" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #4338CA; font-size: 11.5px; border-bottom: 1px solid #C7D2FE; padding-bottom: 2px; margin-bottom: 4px;&quot;&gt;🌲 CatBoost Classifier&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Oblivious trees simétricos&lt;br/&gt;• Target encoding dinámico&lt;br/&gt;• AUC: 0.7328 | Brier: 0.1039&lt;br/&gt;• &lt;b&gt;Líder Top 100: 61.87%&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="840" y="825" width="275" height="155" as="geometry" /></mxCell><mxCell id="n_144" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #4338CA; font-size: 11.5px; border-bottom: 1px solid #C7D2FE; padding-bottom: 2px; margin-bottom: 4px;&quot;&gt;⚡ LightGBM Classifier&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Crecimiento leaf-wise en bins&lt;br/&gt;• Ultra-rápido: 0.9s / bloque&lt;br/&gt;• AUC: 0.7326 | p@100: 61.54%&lt;br/&gt;• &lt;b&gt;Líder Brier: 0.1037&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="840" y="1000" width="275" height="155" as="geometry" /></mxCell><mxCell id="n_145" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #4338CA; font-size: 11.5px; border-bottom: 1px solid #C7D2FE; padding-bottom: 2px; margin-bottom: 4px;&quot;&gt;🚀 XGBoost Classifier&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Regularización analítica L1/L2&lt;br/&gt;• Máxima discriminación global&lt;br/&gt;• Brier: 0.1040 | p@100: 61.70%&lt;br/&gt;• &lt;b&gt;Líder AUC: 0.7333&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="1140" y="825" width="275" height="155" as="geometry" /></mxCell><mxCell id="n_146" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #4338CA; font-size: 11.5px; border-bottom: 1px solid #C7D2FE; padding-bottom: 2px; margin-bottom: 4px;&quot;&gt;🌳 Random Forest (Bagging)&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Ensamble 200 árboles ortogonales&lt;br/&gt;• Reducción de varianza y ruido&lt;br/&gt;• AUC: 0.7282 | p@100: 61.00%&lt;br/&gt;• &lt;b&gt;Brier Score: 0.1037&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="1140" y="1000" width="275" height="155" as="geometry" /></mxCell><mxCell id="n_147" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #4338CA; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #6366F1; padding-bottom: 3px;&quot;&gt;🔢 C.4 Vector de Predicciones Nivel 0&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• &lt;b&gt;Vector de Salida:&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 3px 0; background: #EEF2FF; padding: 4px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #3730A3;&quot;&gt;&lt;b&gt;P&lt;/b&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; = [&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Cat&lt;/sub&gt;, &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Lgb&lt;/sub&gt;, &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Xgb&lt;/sub&gt;, &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;RF&lt;/sub&gt;] ∈ [0, 1]&lt;sup&gt;4&lt;/sup&gt;&lt;/div&gt;• &lt;b&gt;Diversidad Empírica:&lt;/b&gt; Matriz de correlación Spearman ρ ∈ [0.88, 0.94].&lt;br/&gt;• Complementariedad de errores confirmada para el meta-aprendizaje de Nivel 1.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1450" y="825" width="350" height="330" as="geometry" /></mxCell><mxCell id="n_148" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #C2410C; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #EA580C; padding-bottom: 3px;&quot;&gt;📈 C.5 Auditoría de 365 Pruebas Diarias de Wilcoxon&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• Evaluación pareada día a día en todo 2025 con corrección Holm-Bonferroni.&lt;br/&gt;• Los ensambles superan a cada individual en las &lt;b&gt;16 comparaciones pareadas&lt;/b&gt; (&lt;i&gt;p&lt;/i&gt; &amp;lt; 0.01).&lt;br/&gt;• Demuestra significancia estadística rigurosa frente a fluctuaciones aleatorias del mercado.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1835" y="825" width="450" height="330" as="geometry" /></mxCell><mxCell id="e_149" value="Features X" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#EA580C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n_126" target="n_140"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1925" y="765" /><mxPoint x="255" y="765" /></Array></mxGeometry></mxCell><mxCell id="e_150" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#EA580C;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_140" target="n_141"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_151" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#EA580C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n_141" target="n_142"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_152" value="Train 1:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6366F1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_142" target="n_143"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_153" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6366F1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_142" target="n_144"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_154" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#6366F1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_143" target="n_145"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_155" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#6366F1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_144" target="n_146"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_156" value="Probabilidades" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6366F1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="n_145" target="n_147"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_157" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6366F1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="n_146" target="n_147"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_158" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6366F1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_147" target="n_148"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_159" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#9333EA;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="1230" width="2340" height="360" as="geometry" /></mxCell><mxCell id="n_160" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; font-weight: 800; color: #FFFFFF;&quot;&gt;CAPA D: META-APRENDIZAJE DE NIVEL 1, APORTE DE TESIS (STJC) &amp; MODEL REGISTRY&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#6B21A8;strokeColor=#9333EA;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="1216" width="690" height="28" as="geometry" /></mxCell><mxCell id="n_161" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #6B21A8; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #9333EA; padding-bottom: 3px;&quot;&gt;🧪 D.1 Espacio de 39 Ensambles (12 Familias)&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;• Votación Suave, Ponderada, Dura y Rank Averaging.&lt;br/&gt;• Stacking Lineal, Lasso L1, Ridge L2, ElasticNet.&lt;br/&gt;• Stacking No Negativo, Meta-RF, Blending 20%.&lt;br/&gt;• Selección Greedy de Caruana (con y sin calibración).&lt;br/&gt;• Dynamic Selection por Grifo y Mixture of Experts (MoE).&lt;br/&gt;• &lt;b&gt;Filtro Multicriterio:&lt;/b&gt; Solo 8 ensambles superaron el 4 de 4.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D5FF;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="90" y="1270" width="370" height="280" as="geometry" /></mxCell><mxCell id="n_162" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #9333EA; padding-bottom: 4px; margin-bottom: 6px;&quot;&gt;&lt;span style=&quot;font-weight: 800; color: #6B21A8; font-size: 12.5px;&quot;&gt;🌟 D.2 APORTE NUCLEAR: STJC (Stacking Temporal Jerárquico)&lt;/span&gt;&lt;span style=&quot;background: #F3E8FF; color: #581C87; padding: 2px 8px; border-radius: 8px; font-weight: 800; font-size: 10px;&quot;&gt;Récords 4 de 4&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;1. &lt;b&gt;Multiventana Temporal (3 meses):&lt;/b&gt; Meta-entrenamiento en ventanas históricas purgadas.&lt;br/&gt;2. &lt;b&gt;Restricción Convexa:&lt;/b&gt; &lt;i&gt;w&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; ≥ 0, &amp;nbsp; ∑ &lt;i&gt;w&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; = 1 (elimina coeficientes negativos inestables).&lt;br/&gt;3. &lt;b&gt;Contracción Analítica (Shrinkage λ = 0.25):&lt;/b&gt; Resuelve multicolinealidad hacia pesos uniformes:&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 3px 0; background: #FAF5FF; padding: 3px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #581C87;&quot;&gt;&lt;b&gt;w&lt;/b&gt;* = (1 − λ) &lt;b&gt;w&lt;/b&gt; + λ [0.25, 0.25, 0.25, 0.25]&lt;sup&gt;T&lt;/sup&gt;&lt;/div&gt;4. &lt;b&gt;Ponderación Jerárquica:&lt;/b&gt; Especialización por familia de combustible.&lt;br/&gt;5. &lt;b&gt;Bagging Temporal:&lt;/b&gt; Promediado de ventanas para mitigación de varianza.&lt;br/&gt;&lt;div style=&quot;background: #FAF5FF; border: 1.5px solid #D8B4FE; border-radius: 4px; padding: 4px; margin-top: 4px; font-size: 11px; color: #581C87; font-weight: 800; text-align: center;&quot;&gt;🏆 RÉCORDS HISTÓRICOS: p@50 = 70.23% | p@100 = 62.51% | Brier = 0.1031&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8B4FE;strokeWidth=2;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="495" y="1260" width="640" height="300" as="geometry" /></mxCell><mxCell id="n_163" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #9333EA; padding-bottom: 4px; margin-bottom: 6px;&quot;&gt;&lt;span style=&quot;font-weight: 800; color: #6B21A8; font-size: 12.5px;&quot;&gt;🏆 D.3 Votación Suave (Producción)&lt;/span&gt;&lt;span style=&quot;background: #F3E8FF; color: #581C87; padding: 2px 8px; border-radius: 8px; font-weight: 800; font-size: 10px;&quot;&gt;Despliegue 2026&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Promedio Simple Parsimonioso:&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 4px 0; background: #FAF5FF; padding: 4px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #581C87;&quot;&gt;&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;final&lt;/sub&gt; = ¼ (&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Cat&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Lgb&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Xgb&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;RF&lt;/sub&gt;)&lt;/div&gt;• &lt;b&gt;Récord Absoluto de AUC: 0.7355&lt;/b&gt;.&lt;br/&gt;• Cero parámetros que sobreajustar en producción.&lt;br/&gt;• 0 ms de cómputo meta adicional en el batch diario.&lt;br/&gt;• Seleccionado formalmente para operar en 2026.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8B4FE;strokeWidth=2;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1165" y="1270" width="430" height="280" as="geometry" /></mxCell><mxCell id="n_164" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #6B21A8; font-size: 12px;&quot;&gt;🗄️ Model Registry&lt;/div&gt;&lt;div style=&quot;color: #334155; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Almacén de Modelos&lt;/b&gt;&lt;br/&gt;• Pesos serializados (&lt;code&gt;.joblib&lt;/code&gt;)&lt;br/&gt;• Pipelines calibrados&lt;br/&gt;• Versiones y metadatos&lt;br/&gt;• Reentrenamiento trimestral&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="1630" y="1285" width="220" height="250" as="geometry" /></mxCell><mxCell id="n_165" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 6px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #6B21A8; font-size: 11.5px;&quot;&gt;🎯 Modelo Listo para Servicio&lt;/div&gt;&lt;div style=&quot;color: #475569; font-size: 10px; margin-top: 3px;&quot;&gt;Probabilidad final &lt;i&gt;P&lt;/i&gt;(cambio) calibrada para inferencia nocturna&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;dashed=1;" parent="1" vertex="1"><mxGeometry x="1890" y="1355" width="280" height="110" as="geometry" /></mxCell><mxCell id="e_166" value="Vector P_t" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333EA;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n_147" target="n_161"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1625" y="1215" /><mxPoint x="275" y="1215" /></Array></mxGeometry></mxCell><mxCell id="e_167" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333EA;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_161" target="n_162"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_168" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333EA;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_162" target="n_163"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_169" value="Artefactos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333EA;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_163" target="n_164"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_170" value="Modelo Producción" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333EA;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_164" target="n_165"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_171" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#059669;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="1620" width="2340" height="360" as="geometry" /></mxCell><mxCell id="n_172" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; font-weight: 800; color: #FFFFFF;&quot;&gt;CAPA E: MOTOR DE INFERENCIA DIARIA, PRIORIZACIÓN TOP-K &amp; FISCALIZACIÓN EN CAMPO (OSINERGMIN)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#065F46;strokeColor=#059669;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="1606" width="760" height="28" as="geometry" /></mxCell><mxCell id="n_173" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #065F46; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #059669; padding-bottom: 3px;&quot;&gt;⏰ E.1 Scheduler Nocturno (Medianoche)&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• Disparo automático tras el cierre oficial de reportes del SCOP.&lt;br/&gt;• Actualización del panel diario nacional.&lt;br/&gt;• Extracción vectorizada instantánea de las 29 variables.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="90" y="1665" width="340" height="270" as="geometry" /></mxCell><mxCell id="n_174" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #065F46; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #059669; padding-bottom: 3px;&quot;&gt;⚙️ E.2 Motor de Inferencia en Batch&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• Scoring probabilístico sobre &lt;b&gt;~19,292 grifos activos&lt;/b&gt; en &amp;lt; 2 minutos.&lt;br/&gt;• Asignación de &lt;i&gt;P&lt;/i&gt;(cambio | &lt;b&gt;X&lt;/b&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt;) para cada establecimiento.&lt;br/&gt;• Ordenamiento descendente en cola de prioridad.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="465" y="1665" width="370" height="270" as="geometry" /></mxCell><mxCell id="n_175" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #065F46; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #059669; padding-bottom: 3px;&quot;&gt;📋 E.3 Despacho de Listas Top-K&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• &lt;b&gt;Top 50:&lt;/b&gt; Inspecciones de alta certeza (&lt;b&gt;70.23%&lt;/b&gt; precisión).&lt;br/&gt;• &lt;b&gt;Top 100:&lt;/b&gt; Lista operativa estándar diaria (&lt;b&gt;62.51%&lt;/b&gt; precisión).&lt;br/&gt;• &lt;b&gt;Top 250:&lt;/b&gt; Operativos nacionales masivos (&lt;b&gt;53.08%&lt;/b&gt; precisión).&lt;br/&gt;• Despacho focalizado a fiscalizadores regionales de Osinergmin.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="870" y="1665" width="390" height="270" as="geometry" /></mxCell><mxCell id="n_176" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #065F46; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #059669; padding-bottom: 3px;&quot;&gt;🎖️ E.4 Validación en Campo Real (262 Días 2026)&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• &lt;b&gt;26,200 visitas simuladas&lt;/b&gt; en el Top 100.&lt;br/&gt;• &lt;span style=&quot;color:#065F46; font-weight:800;&quot;&gt;20,539 visitas con cambio confirmado (78.39% precisión real)&lt;/span&gt;.&lt;br/&gt;• &lt;b&gt;Mes Pico (Julio 2026):&lt;/b&gt; &lt;u&gt;93.00%&lt;/u&gt; de efectividad en el Top 100.&lt;br/&gt;• &lt;b&gt;100% de trazabilidad física&lt;/b&gt; verificada contra actas del SCOP.&lt;br/&gt;• Generalización en 7,431 grifos 'nunca vistos' (AUC 0.7439).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=2;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1295" y="1660" width="530" height="280" as="geometry" /></mxCell><mxCell id="n_177" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #065F46; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #059669; padding-bottom: 3px;&quot;&gt;🛡️ E.5 Impacto Regulatorio&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.45;&quot;&gt;• Supervisión inteligente orientada a riesgo.&lt;br/&gt;• Reducción drástica de inspecciones fallidas.&lt;br/&gt;• Mayor disuasión frente a especulación de precios.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1860" y="1665" width="340" height="270" as="geometry" /></mxCell><mxCell id="e_178" value="Modelo Desplegado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n_165" target="n_173"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2030" y="1605" /><mxPoint x="260" y="1605" /></Array></mxGeometry></mxCell><mxCell id="e_179" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_173" target="n_174"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_180" value="Scores P" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_174" target="n_175"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_181" value="Listas Diarias" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_175" target="n_176"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_182" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_176" target="n_177"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_183" value="&lt;div style=&quot;background:#FFFFFF;border:1.5px solid #0D9488;padding:3px 10px;border-radius:6px;font-size:10px;font-weight:700;color:#0F766E;&quot;&gt;Bucle de Retroalimentación Operativa (Reentrenamiento Trimestral &amp; Monitoreo de Deriva)&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=2.5;strokeColor=#0D9488;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_176" target="n_140"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="2000" /><mxPoint x="35" y="2000" /><mxPoint x="35" y="990" /></Array></mxGeometry></mxCell><mxCell id="n_184" value="&lt;div style=&quot;display: flex; justify-content: space-around; align-items: center; font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; color: #334155; padding: 4px;&quot;&gt;&lt;div&gt;&lt;b&gt;LEYENDA:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;🗄️ &lt;b&gt;Cilindro:&lt;/b&gt; Base de Datos / Almacén Persistente&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;📦 &lt;b&gt;Caja:&lt;/b&gt; Componente de Procesamiento de Pipeline&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;🌟 &lt;b&gt;Tarjeta Destacada:&lt;/b&gt; Aporte Científico de la Tesis (STJC)&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#3B82F6;&quot;&gt;━━▶&lt;/span&gt; &lt;b&gt;Flujo de Datos&lt;/b&gt;&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#6366F1;&quot;&gt;━━▶&lt;/span&gt; &lt;b&gt;Flujo de Modelado&lt;/b&gt;&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#059669;&quot;&gt;━━▶&lt;/span&gt; &lt;b&gt;Inferencia Operativa&lt;/b&gt;&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#0D9488;&quot;&gt;- - -▶&lt;/span&gt; &lt;b&gt;Bucle de Retroalimentación&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="2030" width="2340" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="diag_serpiente_es" name="Flujo Metodológico (Serpiente - Artículo)"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n_185" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif;&quot;&gt;&lt;div style=&quot;font-size: 19px; font-weight: 800; color: #0F172A; text-transform: uppercase; letter-spacing: 0.5px;&quot;&gt;Flujo Metodológico del Sistema de Priorización SCOP (Osinergmin)&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 500; color: #475569; margin-top: 3px;&quot;&gt;Diseño en Dos Filas (Serpiente): Desde los Datos Transaccionales Crudos hasta la Fiscalización Inteligente en Campo&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="50" y="20" width="1600" height="60" as="geometry" /></mxCell><mxCell id="n_186" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #3B82F6; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #1E3A8A; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;01&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;INGESTA DE DATOS Y PRIVACIDAD&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;🗄️🔍&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;Reportes Regulatorios Crudos del SCOP:&lt;/b&gt; Base transaccional de ~1.1 GB con 15.1M de registros históricos (2020–2026).&lt;br/&gt;• &lt;b&gt;5 Familias de Combustibles:&lt;/b&gt; Diésel B5 S-50, Gasohol Regular, Gasohol Premium, GLP Granel (GLP-G) y GLP Cilindro (GLP-E).&lt;br/&gt;• &lt;b&gt;Anonimización Criptográfica:&lt;/b&gt; Seudonimización irreversible de los identificadores (&lt;code&gt;idn&lt;/code&gt;) mediante hash HMAC-SHA256 con sal secreta.&lt;br/&gt;• &lt;b&gt;Garantía Institucional:&lt;/b&gt; Preserva relaciones espaciales y consistencia longitudinal protegiendo el secreto comercial.&lt;/div&gt;&lt;div style=&quot;margin-top: 10px; background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #1E40AF; font-weight: 600;&quot;&gt;📦 Fuente: Organismo Supervisor de la Inversión en Energía y Minería&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="60" y="110" width="480" height="320" as="geometry" /></mxCell><mxCell id="n_187" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #0D9488; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #0F766E; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;02&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;RECONSTRUCCIÓN DEL PANEL&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;📈📊&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;Expansión Cartesiana Completa:&lt;/b&gt; Malla diaria por &lt;code&gt;[Establecimiento × Combustible × Día]&lt;/code&gt; (~39.1M obs).&lt;br/&gt;• &lt;b&gt;Regla de Arrastre (Forward-Fill):&lt;/b&gt; Imputación del último precio vigente para reflejar la realidad física en tótem.&lt;br/&gt;• &lt;b&gt;Etiqueta Objetivo Binaria (&lt;i&gt;H&lt;/i&gt; = 5 Días):&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 4px 0; background: #F0FDFA; padding: 4px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #0F766E;&quot;&gt;&lt;i&gt;Y&lt;sub&gt;i,t&lt;/sub&gt;&lt;/i&gt; = 1 si cambia el precio en los siguientes 5 días; 0 en caso contrario&lt;/div&gt;• &lt;b&gt;Universo Activo Diario:&lt;/b&gt; Monitoreo de &lt;b&gt;~19,292 establecimientos&lt;/b&gt;.&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; background: #CCFBF1; border: 1px solid #99F6E4; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #115E59; font-weight: 600;&quot;&gt;🎯 Definición Operativa: Modificación de precio en los 5 días posteriores&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="610" y="110" width="480" height="320" as="geometry" /></mxCell><mxCell id="n_188" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #4F46E5; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #4338CA; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;03&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;INGENIERÍA DE CARACTERÍSTICAS&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;⚙️🔢&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;Dinámica e Inercia de Precios (10 vars):&lt;/b&gt; Días sin cambio, conteos en 7/14/28d, volatilidad móvil (&lt;code&gt;desv_est_28d&lt;/code&gt;).&lt;br/&gt;• &lt;b&gt;Transmisión Mayorista &amp; Macro (6 vars):&lt;/b&gt; Costo ex-planta Petroperú, margen bruto estimado, tipo de cambio USD/PEN.&lt;br/&gt;• &lt;b&gt;Presión Competitiva Espacial (8 vars):&lt;/b&gt; Δ&lt;i&gt;P&lt;/i&gt; vs. mediana vecina, densidad en 1/3/5 km, distancia al rival más cercano.&lt;br/&gt;• &lt;b&gt;Tasa de Riesgo de Espera ('Despertador'):&lt;/b&gt; Función no lineal condicionada a días de inactividad.&lt;br/&gt;• &lt;b&gt;Perfil Estructural (5 vars):&lt;/b&gt; Combustible, actividad y región.&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; background: #EEF2FF; border: 1px solid #C7D2FE; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #3730A3; font-weight: 600;&quot;&gt;📐 Vector Resultante: &lt;b&gt;X&lt;/b&gt; ∈ ℝ²⁹ dimensiones (Control VIF &amp;lt; 5)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="1160" y="110" width="480" height="320" as="geometry" /></mxCell><mxCell id="n_189" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #EA580C; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #C2410C; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;04&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;DISEÑO WALK-FORWARD PURGADO&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;📅⚖️&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;12 Bloques Mensuales de Validación (2025):&lt;/b&gt; Ventana rodante de 6 meses (180 días) evaluada mes a mes.&lt;br/&gt;• &lt;b&gt;Ventana de Purga de 5 Días:&lt;/b&gt; Brecha ciega obligatoria para eliminar solapamiento y filtración hacia el futuro.&lt;br/&gt;• &lt;b&gt;Submuestreo Balanceado 1:1 en Train:&lt;/b&gt; &lt;i&gt;N&lt;/i&gt; = 100,000 filas/bloque para estabilidad de gradientes y eficiencia.&lt;br/&gt;• &lt;b&gt;Calibración de Dal Pozzolo (2015):&lt;/b&gt; Reajuste analítico exacto: logit(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;real&lt;/sub&gt;) = logit(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;sub&lt;/sub&gt;) − ln(β).&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; background: #FFF7ED; border: 1px solid #FED7AA; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #9A3412; font-weight: 600;&quot;&gt;🛡️ Validación Temporal Estricta: Cero Fuga de Información&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="60" y="560" width="480" height="320" as="geometry" /></mxCell><mxCell id="n_190" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #9333EA; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #6B21A8; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;05&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;MODELOS BASE Y ENSAMBLE (STJC)&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;🌲🥞&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;Modelos de Nivel 0:&lt;/b&gt; CatBoost (p@100 líder: 61.87%), LightGBM (Brier líder: 0.1037), XGBoost (AUC líder: 0.7333), Random Forest.&lt;br/&gt;• &lt;b&gt;STJC (Aporte de Tesis):&lt;/b&gt; Stacking Temporal Jerárquico con Contracción (Multiventana 3m, &lt;i&gt;w&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; ≥ 0, ∑ &lt;i&gt;w&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; = 1, Shrinkage λ = 0.25):&lt;br/&gt;  &lt;span style=&quot;color:#6B21A8; font-weight:700;&quot;&gt;🏆 Récord Top 50: 70.23% | Récord Top 100: 62.51% | Brier: 0.1031&lt;/span&gt;&lt;br/&gt;• &lt;b&gt;Votación Suave (Producción 2026):&lt;/b&gt; &lt;i&gt;P&lt;/i&gt; = ¼ ∑ &lt;i&gt;P&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; (AUC récord: &lt;u&gt;0.7355&lt;/u&gt;; parsimonioso, 0ms overhead, invulnerable a sobreajuste).&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; background: #FAF5FF; border: 1px solid #E9D5FF; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #581C87; font-weight: 600;&quot;&gt;🌟 Wilcoxon 365 días: Ensambles derrotan a individuales (16/16, &lt;i&gt;p&lt;/i&gt; &amp;lt; 0.01)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8B4FE;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="610" y="560" width="480" height="320" as="geometry" /></mxCell><mxCell id="n_191" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #059669; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #065F46; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;06&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;DESPLIEGUE OPERATIVO (2026)&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;🎯🎖️&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;Priorización Diaria Top-K:&lt;/b&gt; Ranking nocturno descendente por &lt;i&gt;P&lt;/i&gt;(cambio) para despacho de cuadrillas de Osinergmin.&lt;br/&gt;• &lt;b&gt;Resultados en 262 Días de Prueba Real:&lt;/b&gt;&lt;br/&gt;  &lt;span style=&quot;color:#065F46; font-weight:700;&quot;&gt;20,539 visitas con cambio confirmado (78.39% precisión real)&lt;/span&gt;.&lt;br/&gt;• &lt;b&gt;Mes Pico (Julio 2026):&lt;/b&gt; &lt;u&gt;93.00%&lt;/u&gt; de efectividad en el Top 100.&lt;br/&gt;• &lt;b&gt;Prueba Ciega en 7,431 Grifos 'Nunca Vistos':&lt;/b&gt; AUC = &lt;u&gt;0.7439&lt;/u&gt;.&lt;br/&gt;• &lt;b&gt;Trazabilidad Total:&lt;/b&gt; 100% verificado contra reportes físicos de campo.&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #064E3B; font-weight: 600;&quot;&gt;🚀 Impacto: Fiscalización eficiente basada en riesgo y disuasión de mercado&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="1160" y="560" width="480" height="320" as="geometry" /></mxCell><mxCell id="e_192" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=3;strokeColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_186" target="n_187"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_193" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=3;strokeColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_187" target="n_188"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_194" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=3.5;strokeColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_188" target="n_189"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1660" y="270" /><mxPoint x="1660" y="495" /><mxPoint x="30" y="495" /><mxPoint x="30" y="720" /></Array></mxGeometry></mxCell><mxCell id="e_195" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=3;strokeColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_189" target="n_190"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_196" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=3;strokeColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_190" target="n_191"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_197" value="&lt;div style=&quot;display: flex; justify-content: space-around; align-items: center; font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; color: #475569;&quot;&gt;&lt;div&gt;&lt;b&gt;Dataset Primario:&lt;/b&gt; SCOP Osinergmin 2020–2026 (15.1M filas, 5 combustibles)&lt;/div&gt;&lt;div&gt;•&lt;/div&gt;&lt;div&gt;&lt;b&gt;Protocolo:&lt;/b&gt; 12 Bloques Walk-Forward 2025 (Purga 5d)&lt;/div&gt;&lt;div&gt;•&lt;/div&gt;&lt;div&gt;&lt;b&gt;Meta-Modelo:&lt;/b&gt; STJC (Shrinkage 0.25) + Votación Suave (Producción)&lt;/div&gt;&lt;div&gt;•&lt;/div&gt;&lt;div&gt;&lt;b&gt;Evaluación Operativa:&lt;/b&gt; 262 días continuos 2026 (20,539 aciertos en campo)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="50" y="920" width="1600" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="diag_snake_en" name="Methodological Flow (Snake - Journal Paper)"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n_198" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif;&quot;&gt;&lt;div style=&quot;font-size: 19px; font-weight: 800; color: #0F172A; text-transform: uppercase; letter-spacing: 0.5px;&quot;&gt;Methodological Architecture for Regulatory Fuel Price Inspection (SCOP / Osinergmin)&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 500; color: #475569; margin-top: 3px;&quot;&gt;Two-Row Pipeline (Snake S-Curve): From Raw High-Frequency Filings to Machine Learning Risk-Based Supervision&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="50" y="20" width="1600" height="60" as="geometry" /></mxCell><mxCell id="n_199" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #3B82F6; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #1E3A8A; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;01&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;DATA INGESTION &amp; PRIVACY&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;🗄️🔍&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;Raw SCOP Regulatory Reports:&lt;/b&gt; Massive ~1.1 GB transaction database with 15.1M records (2020–2026).&lt;br/&gt;• &lt;b&gt;5 Regulated Fuel Families:&lt;/b&gt; Diesel B5 S-50, Regular Gasoline, Premium Gasoline, Bulk LPG, and 10kg Cylinder LPG.&lt;br/&gt;• &lt;b&gt;Salted HMAC-SHA256 Pseudonymization:&lt;/b&gt; One-way cryptographic transformation of commercial fuel station IDs (&lt;code&gt;idn&lt;/code&gt;).&lt;br/&gt;• &lt;b&gt;Institutional Integrity:&lt;/b&gt; Preserves longitudinal continuity while enforcing data confidentiality compliance.&lt;/div&gt;&lt;div style=&quot;margin-top: 10px; background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #1E40AF; font-weight: 600;&quot;&gt;📦 Source: Osinergmin (Energy Regulatory Body of Peru)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="60" y="110" width="480" height="320" as="geometry" /></mxCell><mxCell id="n_200" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #0D9488; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #0F766E; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;02&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;PANEL RECONSTRUCTION&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;📈📊&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;Cartesian Time Expansion:&lt;/b&gt; Complete &lt;code&gt;[Station × Fuel × Day]&lt;/code&gt; panel (39.1M daily observations).&lt;br/&gt;• &lt;b&gt;Forward-Fill Carry Rule:&lt;/b&gt; Stations report only upon price modification; previous active price carried forward.&lt;br/&gt;• &lt;b&gt;Binary Target Label (&lt;i&gt;H&lt;/i&gt; = 5 Forward Days):&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 4px 0; background: #F0FDFA; padding: 4px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #0F766E;&quot;&gt;&lt;i&gt;Y&lt;sub&gt;i,t&lt;/sub&gt;&lt;/i&gt; = 1 if price changes within next 5 days; 0 otherwise&lt;/div&gt;• &lt;b&gt;Daily Active Population:&lt;/b&gt; Continuous monitoring of &lt;b&gt;~19,292 active stations&lt;/b&gt;.&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; background: #CCFBF1; border: 1px solid #99F6E4; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #115E59; font-weight: 600;&quot;&gt;🎯 Operational Target: Price modification during subsequent 5 days&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="610" y="110" width="480" height="320" as="geometry" /></mxCell><mxCell id="n_201" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #4F46E5; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #4338CA; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;03&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;FEATURE ENGINEERING (29 VARS)&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;⚙️🔢&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;Behavioral Inertia &amp; Volatility (10 vars):&lt;/b&gt; Days since last change, 7/14/28-day update counts, 28-day rolling std.&lt;br/&gt;• &lt;b&gt;Wholesale Momentum &amp; Cost Pass-Through (6 vars):&lt;/b&gt; Petroperú ex-refinery prices, estimated margin, USD/PEN rate.&lt;br/&gt;• &lt;b&gt;Provincial Competition (8 vars):&lt;/b&gt; Spread to median Δ&lt;i&gt;P&lt;/i&gt;, 1/3/5 km station density, nearest rival distance.&lt;br/&gt;• &lt;b&gt;Wait-Time Hazard Rate ('Despertador'):&lt;/b&gt; Non-linear anomaly hazard rate modeling escalating change probability.&lt;br/&gt;• &lt;b&gt;Structural Attributes (5 vars):&lt;/b&gt; Product family, license type, region.&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; background: #EEF2FF; border: 1px solid #C7D2FE; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #3730A3; font-weight: 600;&quot;&gt;📐 Final Vector: &lt;b&gt;X&lt;/b&gt; ∈ ℝ²⁹ dimensions (VIF &amp;lt; 5 collinearity filtering)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="1160" y="110" width="480" height="320" as="geometry" /></mxCell><mxCell id="n_202" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #EA580C; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #C2410C; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;04&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;PURGED WALK-FORWARD DESIGN&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;📅⚖️&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;12 Monthly Validation Blocks (2025):&lt;/b&gt; 6-month rolling train window (180 days) evaluated iteratively on untouched months.&lt;br/&gt;• &lt;b&gt;5-Day Purge Window:&lt;/b&gt; Strict blind interval between training and test sets to eliminate label overlap leakage.&lt;br/&gt;• &lt;b&gt;1:1 Negative Subsampling:&lt;/b&gt; &lt;i&gt;N&lt;/i&gt; = 100,000 rows per block for memory efficiency and balanced gradient descent.&lt;br/&gt;• &lt;b&gt;Dal Pozzolo (2015) Calibration:&lt;/b&gt; Closed-form correction: logit(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;real&lt;/sub&gt;) = logit(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;sub&lt;/sub&gt;) − ln(β).&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; background: #FFF7ED; border: 1px solid #FED7AA; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #9A3412; font-weight: 600;&quot;&gt;🛡️ Strict Temporal Integrity: Zero Future Look-Ahead Leakage&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="60" y="560" width="480" height="320" as="geometry" /></mxCell><mxCell id="n_203" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #9333EA; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #6B21A8; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;05&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;BASE MODELS &amp; ENSEMBLE (STJC)&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;🌲🥞&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;Level-0 Base Learners:&lt;/b&gt; CatBoost (top p@100: 61.87%), LightGBM (top Brier: 0.1037), XGBoost (top AUC: 0.7333), Random Forest.&lt;br/&gt;• &lt;b&gt;STJC (Thesis Novelty):&lt;/b&gt; Hierarchical Temporal Stacking with Shrinkage (3m multi-window, &lt;i&gt;w&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; ≥ 0, ∑ &lt;i&gt;w&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; = 1, shrinkage λ = 0.25):&lt;br/&gt;  &lt;span style=&quot;color:#6B21A8; font-weight:700;&quot;&gt;🏆 Global Records: p@50: 70.23% | p@100: 62.51% | Brier: 0.1031&lt;/span&gt;&lt;br/&gt;• &lt;b&gt;Soft Voting (Production Winner):&lt;/b&gt; &lt;i&gt;P&lt;/i&gt; = ¼ ∑ &lt;i&gt;P&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; (Absolute AUC Record: &lt;u&gt;0.7355&lt;/u&gt;; parsimonious, robust, zero meta-latency).&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; background: #FAF5FF; border: 1px solid #E9D5FF; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #581C87; font-weight: 600;&quot;&gt;🌟 365-Day Wilcoxon Test: Ensembles beat base models (16/16, &lt;i&gt;p&lt;/i&gt; &amp;lt; 0.01)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8B4FE;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="610" y="560" width="480" height="320" as="geometry" /></mxCell><mxCell id="n_204" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; padding: 4px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #059669; padding-bottom: 6px; margin-bottom: 10px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; gap: 8px;&quot;&gt;&lt;span style=&quot;background: #065F46; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 6px;&quot;&gt;06&lt;/span&gt;&lt;span style=&quot;font-weight: 800; font-size: 13px; color: #0F172A; letter-spacing: 0.3px;&quot;&gt;OUT-OF-TIME DEPLOYMENT (2026)&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;🎯🎖️&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; font-size: 11.5px; line-height: 1.55;&quot;&gt;• &lt;b&gt;Top-K Daily Priority Ranking:&lt;/b&gt; Midnight batch scoring over ~19,292 active stations for field dispatch.&lt;br/&gt;• &lt;b&gt;Real-World Audit (262 Test Days in 2026):&lt;/b&gt;&lt;br/&gt;  &lt;span style=&quot;color:#065F46; font-weight:700;&quot;&gt;20,539 verified positive inspections (78.39% precision@100)&lt;/span&gt;.&lt;br/&gt;• &lt;b&gt;Peak Month (July 2026):&lt;/b&gt; &lt;u&gt;93.00%&lt;/u&gt; precision in Top-100.&lt;br/&gt;• &lt;b&gt;Blind Generalization on 7,431 'Unseen' Stations:&lt;/b&gt; AUC = &lt;u&gt;0.7439&lt;/u&gt;.&lt;br/&gt;• &lt;b&gt;100% Physical Audit Traceability:&lt;/b&gt; Validated against SCOP records.&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 6px; padding: 4px 8px; font-size: 10.5px; color: #064E3B; font-weight: 600;&quot;&gt;🚀 Impact: Targeted field enforcement, reduced wasted inspections, deterrence&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=2;shadow=1;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="1160" y="560" width="480" height="320" as="geometry" /></mxCell><mxCell id="e_205" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=3;strokeColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_199" target="n_200"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_206" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=3;strokeColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_200" target="n_201"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_207" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=3.5;strokeColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_201" target="n_202"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1660" y="270" /><mxPoint x="1660" y="495" /><mxPoint x="30" y="495" /><mxPoint x="30" y="720" /></Array></mxGeometry></mxCell><mxCell id="e_208" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=3;strokeColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_202" target="n_203"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_209" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=3;strokeColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_203" target="n_204"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_210" value="&lt;div style=&quot;display: flex; justify-content: space-around; align-items: center; font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; color: #475569;&quot;&gt;&lt;div&gt;&lt;b&gt;Primary Dataset:&lt;/b&gt; SCOP Osinergmin 2020–2026 (15.1M records, 5 fuels)&lt;/div&gt;&lt;div&gt;•&lt;/div&gt;&lt;div&gt;&lt;b&gt;Protocol:&lt;/b&gt; 12 Monthly Walk-Forward Blocks 2025 (5d purge)&lt;/div&gt;&lt;div&gt;•&lt;/div&gt;&lt;div&gt;&lt;b&gt;Meta-Model:&lt;/b&gt; STJC (Shrinkage 0.25) + Soft Voting (Production Winner)&lt;/div&gt;&lt;div&gt;•&lt;/div&gt;&lt;div&gt;&lt;b&gt;Field Audit:&lt;/b&gt; 262 continuous days 2026 (20,539 verified inspection hits)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="50" y="920" width="1600" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="diag_columnas_detallado" name="Arquitectura Detallada (6 Fases / Pipeline Completo)"><mxGraphModel dx="2400" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2980" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node_101" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif;&quot;&gt;&lt;div style=&quot;font-size: 21px; font-weight: 800; color: #0F172A; letter-spacing: 0.5px; text-transform: uppercase;&quot;&gt;Arquitectura Metodológica Integral del Sistema de Priorización SCOP (Osinergmin)&lt;/div&gt;&lt;div style=&quot;font-size: 13px; font-weight: 500; color: #475569; margin-top: 4px;&quot;&gt;Flujo Científico: Desde la Ingesta de Datos Transaccionales Masivos hasta la Supervisión en Campo mediante Modelos de Machine Learning y Ensambles Jerárquicos&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="20" width="2840" height="75" as="geometry" /></mxCell><mxCell id="node_102" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#3B82F6;strokeWidth=2;shadow=0;" parent="1" vertex="1"><mxGeometry x="60" y="115" width="445" height="1215" as="geometry" /></mxCell><mxCell id="node_103" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif; color: #FFFFFF; padding: 4px 4px;&quot;&gt;&lt;div style=&quot;display: inline-block; background-color: rgba(255,255,255,0.22); padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 800; letter-spacing: 1px;&quot;&gt;FASE I&lt;/div&gt;&lt;div style=&quot;font-size: 15px; font-weight: 700; margin-top: 4px; letter-spacing: 0.2px;&quot;&gt;Ingesta &amp; Panel Continuo&lt;/div&gt;&lt;div style=&quot;font-size: 10.5px; opacity: 0.92; margin-top: 2px; font-weight: 400;&quot;&gt;Adquisición de Datos, Anonimización y Forward-Fill&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#3B82F6;strokeWidth=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="72" y="127" width="421" height="75" as="geometry" /></mxCell><mxCell id="node_104" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#14B8A6;strokeWidth=2;shadow=0;" parent="1" vertex="1"><mxGeometry x="539" y="115" width="445" height="1215" as="geometry" /></mxCell><mxCell id="node_105" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif; color: #FFFFFF; padding: 4px 4px;&quot;&gt;&lt;div style=&quot;display: inline-block; background-color: rgba(255,255,255,0.22); padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 800; letter-spacing: 1px;&quot;&gt;FASE II&lt;/div&gt;&lt;div style=&quot;font-size: 15px; font-weight: 700; margin-top: 4px; letter-spacing: 0.2px;&quot;&gt;Ingeniería de Características&lt;/div&gt;&lt;div style=&quot;font-size: 10.5px; opacity: 0.92; margin-top: 2px; font-weight: 400;&quot;&gt;29 Predictores Multidimensionales en 4 Familias&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#14B8A6;strokeWidth=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="551" y="127" width="421" height="75" as="geometry" /></mxCell><mxCell id="node_106" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#F97316;strokeWidth=2;shadow=0;" parent="1" vertex="1"><mxGeometry x="1018" y="115" width="445" height="1215" as="geometry" /></mxCell><mxCell id="node_107" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif; color: #FFFFFF; padding: 4px 4px;&quot;&gt;&lt;div style=&quot;display: inline-block; background-color: rgba(255,255,255,0.22); padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 800; letter-spacing: 1px;&quot;&gt;FASE III&lt;/div&gt;&lt;div style=&quot;font-size: 15px; font-weight: 700; margin-top: 4px; letter-spacing: 0.2px;&quot;&gt;Protocolo Walk-Forward&lt;/div&gt;&lt;div style=&quot;font-size: 10.5px; opacity: 0.92; margin-top: 2px; font-weight: 400;&quot;&gt;Validación Temporal con Purga y Balanceo Analítico&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C2410C;strokeColor=#F97316;strokeWidth=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="1030" y="127" width="421" height="75" as="geometry" /></mxCell><mxCell id="node_108" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#6366F1;strokeWidth=2;shadow=0;" parent="1" vertex="1"><mxGeometry x="1497" y="115" width="445" height="1215" as="geometry" /></mxCell><mxCell id="node_109" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif; color: #FFFFFF; padding: 4px 4px;&quot;&gt;&lt;div style=&quot;display: inline-block; background-color: rgba(255,255,255,0.22); padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 800; letter-spacing: 1px;&quot;&gt;FASE IV&lt;/div&gt;&lt;div style=&quot;font-size: 15px; font-weight: 700; margin-top: 4px; letter-spacing: 0.2px;&quot;&gt;Modelos Base (Nivel 1)&lt;/div&gt;&lt;div style=&quot;font-size: 10.5px; opacity: 0.92; margin-top: 2px; font-weight: 400;&quot;&gt;Cuatro Algoritmos de Gradiente y Bagging&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#4338CA;strokeColor=#6366F1;strokeWidth=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="1509" y="127" width="421" height="75" as="geometry" /></mxCell><mxCell id="node_110" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#A855F7;strokeWidth=2;shadow=0;" parent="1" vertex="1"><mxGeometry x="1976" y="115" width="445" height="1215" as="geometry" /></mxCell><mxCell id="node_111" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif; color: #FFFFFF; padding: 4px 4px;&quot;&gt;&lt;div style=&quot;display: inline-block; background-color: rgba(255,255,255,0.22); padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 800; letter-spacing: 1px;&quot;&gt;FASE V&lt;/div&gt;&lt;div style=&quot;font-size: 15px; font-weight: 700; margin-top: 4px; letter-spacing: 0.2px;&quot;&gt;Meta-Aprendizaje &amp; STJC&lt;/div&gt;&lt;div style=&quot;font-size: 10.5px; opacity: 0.92; margin-top: 2px; font-weight: 400;&quot;&gt;Ensambles de Nivel 2 y Aporte Científico de la Tesis&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#6B21A8;strokeColor=#A855F7;strokeWidth=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="1988" y="127" width="421" height="75" as="geometry" /></mxCell><mxCell id="node_112" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#10B981;strokeWidth=2;shadow=0;" parent="1" vertex="1"><mxGeometry x="2455" y="115" width="445" height="1215" as="geometry" /></mxCell><mxCell id="node_113" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif; color: #FFFFFF; padding: 4px 4px;&quot;&gt;&lt;div style=&quot;display: inline-block; background-color: rgba(255,255,255,0.22); padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 800; letter-spacing: 1px;&quot;&gt;FASE VI&lt;/div&gt;&lt;div style=&quot;font-size: 15px; font-weight: 700; margin-top: 4px; letter-spacing: 0.2px;&quot;&gt;Despliegue &amp; Supervisión&lt;/div&gt;&lt;div style=&quot;font-size: 10.5px; opacity: 0.92; margin-top: 2px; font-weight: 400;&quot;&gt;Priorización Top-K Diaria y Validación en Campo (2026)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#065F46;strokeColor=#10B981;strokeWidth=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="2467" y="127" width="421" height="75" as="geometry" /></mxCell><mxCell id="node_114" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #3B82F6; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #1E3A8A;&quot;&gt;🗄️ 1.1 Fuente Primaria SCOP&lt;/span&gt;&lt;span style=&quot;background: #DBEAFE; color: #1E40AF; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Osinergmin&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Datos Transaccionales en Bruto (~1.1 GB):&lt;/b&gt;&lt;br/&gt;• Reportes obligatorios de precios de combustibles (2020–2026).&lt;br/&gt;• &lt;b&gt;5 Familias de Combustibles:&lt;/b&gt; Diésel B5 S-50, Gasohol Regular, Gasohol Premium, GLP Granel (GLP-G) y GLP Envasado (GLP-E).&lt;br/&gt;• &lt;b&gt;Naturaleza Asíncrona:&lt;/b&gt; Reportes dispersos emitidos únicamente ante modificaciones de precio en tótem.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="76" y="215" width="413" height="160" as="geometry" /></mxCell><mxCell id="node_115" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #3B82F6; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #1E3A8A;&quot;&gt;🔒 1.2 Anonimización Criptográfica&lt;/span&gt;&lt;span style=&quot;background: #DBEAFE; color: #1E40AF; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;HMAC-SHA&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Seudonimización de Identificadores:&lt;/b&gt;&lt;br/&gt;• Hash criptográfico HMAC con clave secreta para códigos de registro (`idn`).&lt;br/&gt;• Preserva la consistencia longitudinal de series de tiempo.&lt;br/&gt;• Garantiza estricta confidencialidad comercial y cumplimiento de la Ley de Protección de Datos Personales.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="76" y="390" width="413" height="150" as="geometry" /></mxCell><mxCell id="node_116" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #3B82F6; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #1E3A8A;&quot;&gt;📊 1.3 Panel Diario Continuo&lt;/span&gt;&lt;span style=&quot;background: #DBEAFE; color: #1E40AF; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Forward-Fill&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Expansión Cartesiana de Observabilidad:&lt;/b&gt;&lt;br/&gt;• Malla completa: &lt;code&gt;[Establecimiento × Combustible × Día]&lt;/code&gt;.&lt;br/&gt;• &lt;b&gt;Imputación por Arrastre:&lt;/b&gt; Si no hay reporte hoy, se asume el último precio legal vigente (precio físico en estación).&lt;br/&gt;• Universo activo: &lt;b&gt;~19,292 grifos diarios&lt;/b&gt; en el territorio peruano.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="76" y="555" width="413" height="160" as="geometry" /></mxCell><mxCell id="node_117" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #3B82F6; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #1E3A8A;&quot;&gt;🎯 1.4 Variable Objetivo &amp; Purga&lt;/span&gt;&lt;span style=&quot;background: #DBEAFE; color: #1E40AF; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;H = 5 Días&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Definición Matemática del Target:&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 3px 0; font-weight: 600; background: #F1F5F9; padding: 3px; border-radius: 4px;&quot;&gt;&lt;i&gt;Y&lt;sub&gt;i,t&lt;/sub&gt;&lt;/i&gt; = 1 si cambia el precio en 5 días; 0 en caso contrario&lt;/div&gt;• &lt;b&gt;Horizonte Operativo:&lt;/b&gt; Ventana de 5 días para fiscalización.&lt;br/&gt;• &lt;b&gt;Purga Obligatoria de 5 Días:&lt;/b&gt; Brecha ciega estricta entre entrenamiento y prueba para eliminar &lt;i&gt;Look-Ahead Bias&lt;/i&gt;.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="76" y="730" width="413" height="175" as="geometry" /></mxCell><mxCell id="node_118" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #3B82F6; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #1E3A8A;&quot;&gt;🔍 1.5 Auditoría de Integridad&lt;/span&gt;&lt;span style=&quot;background: #DBEAFE; color: #1E40AF; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Calidad&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Filtros de Calidad y Consistencia:&lt;/b&gt;&lt;br/&gt;• Detección y corrección de outliers de precio (errores tipográficos).&lt;br/&gt;• Verificación de monotonía en marcas temporales (sin viajes al futuro).&lt;br/&gt;• Trazabilidad 1:1 con base de datos oficial del SCOP.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="76" y="920" width="413" height="150" as="geometry" /></mxCell><mxCell id="node_119" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 4px;&quot;&gt;&lt;div style=&quot;font-weight: 700; color: #1E40AF; font-size: 12px; margin-bottom: 3px;&quot;&gt;📦 Salida: Matriz Longitudinal Curada&lt;/div&gt;&lt;div style=&quot;color: #475569; font-size: 10px;&quot;&gt;Panel diario expandido con etiqueta Y_{i,t} y purga temporal estricta&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;dashed=1;" parent="1" vertex="1"><mxGeometry x="76" y="1125" width="413" height="65" as="geometry" /></mxCell><mxCell id="edge_120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" parent="1" source="node_114" target="node_115"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_121" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" parent="1" source="node_115" target="node_116"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_122" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" parent="1" source="node_116" target="node_117"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_123" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" parent="1" source="node_117" target="node_118"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_124" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" parent="1" source="node_118" target="node_119"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node_125" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #0D9488; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #0F766E;&quot;&gt;📈 2.1 Dinámica &amp; Inercia&lt;/span&gt;&lt;span style=&quot;background: #CCFBF1; color: #115E59; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;10 Variables&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Persistencia Temporal de Precios:&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;dias_desde_ult_cambio&lt;/code&gt;: Días de inercia acumulada.&lt;br/&gt;• &lt;code&gt;n_cambios_7&lt;/code&gt;, &lt;code&gt;14&lt;/code&gt;, &lt;code&gt;28&lt;/code&gt;: Frecuencia de saltos históricos.&lt;br/&gt;• &lt;code&gt;var_precio_7d&lt;/code&gt;, &lt;code&gt;28d&lt;/code&gt;: Magnitud porcentual del cambio.&lt;br/&gt;• &lt;code&gt;desv_est_precio_28d&lt;/code&gt;: Volatilidad móvil de precios en el último mes.&lt;br/&gt;• Aceleración del ritmo de actualización en 14 vs. 28 días.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#99F6E4;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="555" y="215" width="413" height="160" as="geometry" /></mxCell><mxCell id="node_126" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #0D9488; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #0F766E;&quot;&gt;🏪 2.2 Presión Competitiva&lt;/span&gt;&lt;span style=&quot;background: #CCFBF1; color: #115E59; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;8 Variables&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Entorno Espacial y Presión Barrial:&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;delta_mediana_vecinos&lt;/code&gt;: Desviación respecto al clúster: \Delta P = P_i - \text{mediana}_{\text{radio}}(P).&lt;br/&gt;• &lt;code&gt;n_competidores_1km&lt;/code&gt;, &lt;code&gt;3km&lt;/code&gt;, &lt;code&gt;5km&lt;/code&gt;: Densidad de competencia.&lt;br/&gt;• &lt;code&gt;dist_min_competidor&lt;/code&gt;: Distancia física al competidor más cercano.&lt;br/&gt;• Percentil de precio del establecimiento dentro de su distrito.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#99F6E4;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="555" y="390" width="413" height="160" as="geometry" /></mxCell><mxCell id="node_127" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #0D9488; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #0F766E;&quot;&gt;🛢️ 2.3 Señal Mayorista &amp; Macro&lt;/span&gt;&lt;span style=&quot;background: #CCFBF1; color: #115E59; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;6 Variables&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Transmisión de Costos Mayoristas:&lt;/b&gt;&lt;br/&gt;• Precios ex-planta de Petroperú / Refinerías (costo mayorista).&lt;br/&gt;• &lt;code&gt;margen_bruto_estimado&lt;/code&gt; = &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;SCOP&lt;/sub&gt; − &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Mayorista&lt;/sub&gt;.&lt;br/&gt;• &lt;code&gt;delta_precio_planta_7d&lt;/code&gt;: Variación semanal del costo ex-planta.&lt;br/&gt;• Tipo de cambio interbancario USD/PEN y referencia WTI.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#99F6E4;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="555" y="565" width="413" height="155" as="geometry" /></mxCell><mxCell id="node_128" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #0D9488; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #0F766E;&quot;&gt;🏢 2.4 Perfil Estructural&lt;/span&gt;&lt;span style=&quot;background: #CCFBF1; color: #115E59; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;5 Variables&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Categorización y Geografía Institucional:&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;combustible_code&lt;/code&gt;: 5 familias de combustibles.&lt;br/&gt;• &lt;code&gt;actividad_code&lt;/code&gt;: Estación, Gasocentro o Puesto de Venta.&lt;br/&gt;• Departamento / Región económica y coordenadas geográficas.&lt;br/&gt;• &lt;b&gt;Dimensión Final:&lt;/b&gt; Vector &lt;b&gt;X&lt;/b&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; ∈ ℝ²⁹ características.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#99F6E4;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="555" y="735" width="413" height="155" as="geometry" /></mxCell><mxCell id="node_129" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #0D9488; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #0F766E;&quot;&gt;📉 2.5 Control de Colinealidad&lt;/span&gt;&lt;span style=&quot;background: #CCFBF1; color: #115E59; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;VIF &amp;lt; 5&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Diagnóstico de Factores de Inflación de Varianza (VIF):&lt;/b&gt;&lt;br/&gt;• Eliminación sistemática de variables colineales duplicadas.&lt;br/&gt;• Matriz de correlación cruzada filtrada (|&lt;i&gt;r&lt;/i&gt;| &amp;lt; 0.85 entre pares).&lt;br/&gt;• Asegura estabilidad numérica para los modelos de gradiente.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#99F6E4;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="555" y="905" width="413" height="160" as="geometry" /></mxCell><mxCell id="node_130" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 4px;&quot;&gt;&lt;div style=&quot;font-weight: 700; color: #0F766E; font-size: 12px; margin-bottom: 3px;&quot;&gt;🔢 Salida: Matriz de Características [X ∈ ℝ^(N×29)]&lt;/div&gt;&lt;div style=&quot;color: #475569; font-size: 10px;&quot;&gt;Vector multidimensional alineado temporalmente sin fuga de información&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;dashed=1;" parent="1" vertex="1"><mxGeometry x="555" y="1125" width="413" height="65" as="geometry" /></mxCell><mxCell id="edge_131" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D9488;strokeWidth=1.5;" edge="1" parent="1" source="node_125" target="node_130"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_132" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D9488;strokeWidth=1.5;" edge="1" parent="1" source="node_126" target="node_130"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_133" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D9488;strokeWidth=1.5;" edge="1" parent="1" source="node_127" target="node_130"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_134" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D9488;strokeWidth=1.5;" edge="1" parent="1" source="node_128" target="node_130"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D9488;strokeWidth=1.5;" edge="1" parent="1" source="node_129" target="node_130"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node_136" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #EA580C; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #C2410C;&quot;&gt;📅 3.1 Walk-Forward (12 Bloques)&lt;/span&gt;&lt;span style=&quot;background: #FFEDD5; color: #9A3412; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;2025&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Validación Temporal Sin Fuga de Datos:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Ventana de Entrenamiento:&lt;/b&gt; 6 meses continuos rodantes (180 días).&lt;br/&gt;• &lt;b&gt;Purga Obligatoria:&lt;/b&gt; 5 días ciegos (&lt;i&gt;t&lt;/i&gt; a &lt;i&gt;t&lt;/i&gt;+5) para eliminar solapamiento de &lt;i&gt;Y&lt;sub&gt;i,t&lt;/sub&gt;&lt;/i&gt;.&lt;br/&gt;• &lt;b&gt;Bloque de Evaluación:&lt;/b&gt; 1 mes calendario completo evaluado día a día (Ene–Dic 2025, 12 bloques).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1034" y="215" width="413" height="160" as="geometry" /></mxCell><mxCell id="node_137" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #EA580C; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #C2410C;&quot;&gt;⚖️ 3.2 Submuestreo Balanceado&lt;/span&gt;&lt;span style=&quot;background: #FFEDD5; color: #9A3412; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;1:1 Train&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Mitigación de Desbalance Severo:&lt;/b&gt;&lt;br/&gt;• Tasa base natural en mercado: &lt;b&gt;~11% a 37%&lt;/b&gt; (eventos raros).&lt;br/&gt;• &lt;b&gt;Estrategia de Entrenamiento:&lt;/b&gt; Submuestreo aleatorio de la clase negativa a razón 1:1 (&lt;i&gt;N&lt;/i&gt; = 100,000 filas/bloque).&lt;br/&gt;• Optimiza el cómputo y enfoca los gradientes en el límite de decisión.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1034" y="390" width="413" height="160" as="geometry" /></mxCell><mxCell id="node_138" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #EA580C; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #C2410C;&quot;&gt;📐 3.3 Calibración de Priors&lt;/span&gt;&lt;span style=&quot;background: #FFEDD5; color: #9A3412; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Dal Pozzolo&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Corrección Analítica de Probabilidades:&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 3px 0; font-weight: 600; background: #FFF7ED; padding: 3px; border-radius: 4px; font-size: 10px;&quot;&gt;logit(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;real&lt;/sub&gt;) = logit(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;sub&lt;/sub&gt;) − ln(β)&lt;/div&gt;• \beta = \frac{\bar{y}_{\text{entreno}}}{\bar{y}_{\text{real}}}: Ajuste del nivel medio.&lt;br/&gt;• &lt;b&gt;Propiedad Teórica:&lt;/b&gt; Transformación monótona; preserva exactamente el ranking y el AUC (0.7333) restaurando el Brier Score real.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1034" y="565" width="413" height="175" as="geometry" /></mxCell><mxCell id="node_139" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #EA580C; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #C2410C;&quot;&gt;📊 3.4 Monitoreo de Tasas Base&lt;/span&gt;&lt;span style=&quot;background: #FFEDD5; color: #9A3412; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Heterogeneidad&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Frecuencia Natural por Combustible (2025–2026):&lt;/b&gt;&lt;br/&gt;• Diésel B5 S-50: &lt;b&gt;40.43%&lt;/b&gt; | Gasohol Regular: &lt;b&gt;37.54%&lt;/b&gt;.&lt;br/&gt;• Gasohol Premium: &lt;b&gt;37.58%&lt;/b&gt; | GLP Granel: &lt;b&gt;27.83%&lt;/b&gt;.&lt;br/&gt;• GLP Envasado en Cilindro (10 kg): &lt;b&gt;8.93%&lt;/b&gt; (extrema rigidez).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1034" y="755" width="413" height="155" as="geometry" /></mxCell><mxCell id="node_140" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #EA580C; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #C2410C;&quot;&gt;🛡️ 3.5 Control de Sobreajuste&lt;/span&gt;&lt;span style=&quot;background: #FFEDD5; color: #9A3412; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Brecha Train-Val&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Monitoreo de Generalización:&lt;/b&gt;&lt;br/&gt;• Cálculo sistemático de \Delta_{\text{sobreajuste}} = \text{AUC}_{\text{entreno}} - \text{AUC}_{\text{val}}.&lt;br/&gt;• Control estricto de hiperparámetros (profundidad, regularización λ).&lt;br/&gt;• Random Forest presentó la mayor brecha (+0.0814); gradiente boosting fue más estable.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1034" y="925" width="413" height="160" as="geometry" /></mxCell><mxCell id="node_141" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 4px;&quot;&gt;&lt;div style=&quot;font-weight: 700; color: #C2410C; font-size: 12px; margin-bottom: 3px;&quot;&gt;🛡️ Salida: Datasets Listos para Nivel 1&lt;/div&gt;&lt;div style=&quot;color: #475569; font-size: 10px;&quot;&gt;Train balanceado 6m + Purga 5d + Validación mensual sin alteraciones&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;dashed=1;" parent="1" vertex="1"><mxGeometry x="1034" y="1125" width="413" height="65" as="geometry" /></mxCell><mxCell id="edge_142" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EA580C;strokeWidth=1.5;" edge="1" parent="1" source="node_136" target="node_137"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_143" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EA580C;strokeWidth=1.5;" edge="1" parent="1" source="node_137" target="node_138"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_144" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EA580C;strokeWidth=1.5;" edge="1" parent="1" source="node_138" target="node_139"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_145" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EA580C;strokeWidth=1.5;" edge="1" parent="1" source="node_139" target="node_140"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_146" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EA580C;strokeWidth=1.5;" edge="1" parent="1" source="node_140" target="node_141"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node_147" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #4F46E5; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #4338CA;&quot;&gt;🌲 4.1 CatBoost Classifier&lt;/span&gt;&lt;span style=&quot;background: #E0E7FF; color: #3730A3; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Líder Top 100&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Árboles simétricos (oblivious) con target encoding dinámico.&lt;br/&gt;• AUC: &lt;b&gt;0.7328&lt;/b&gt; | Brier: &lt;b&gt;0.1039&lt;/b&gt;.&lt;br/&gt;• &lt;b&gt;Líder Base en Inspección Estándar:&lt;/b&gt;&lt;br/&gt;  &lt;span style=&quot;color:#4338CA; font-weight:700;&quot;&gt;p@100 = 61.87% | p@250 = 52.55%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1513" y="215" width="413" height="130" as="geometry" /></mxCell><mxCell id="node_148" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #4F46E5; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #4338CA;&quot;&gt;⚡ 4.2 LightGBM Classifier&lt;/span&gt;&lt;span style=&quot;background: #E0E7FF; color: #3730A3; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Líder Brier&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Crecimiento leaf-wise con bins discretizados en histogramas.&lt;br/&gt;• AUC: &lt;b&gt;0.7326&lt;/b&gt; | p@100: &lt;b&gt;61.54%&lt;/b&gt;.&lt;br/&gt;• &lt;b&gt;Líder Base en Calibración y Costo:&lt;/b&gt;&lt;br/&gt;  &lt;span style=&quot;color:#4338CA; font-weight:700;&quot;&gt;Brier = 0.1037 | Tiempo = 0.9s / bloque&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1513" y="360" width="413" height="130" as="geometry" /></mxCell><mxCell id="node_149" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #4F46E5; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #4338CA;&quot;&gt;🚀 4.3 XGBoost Classifier&lt;/span&gt;&lt;span style=&quot;background: #E0E7FF; color: #3730A3; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Líder AUC&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Regularización analítica rigurosa L1/L2 con Hessian exacto.&lt;br/&gt;• Brier: &lt;b&gt;0.1040&lt;/b&gt; | p@100: &lt;b&gt;61.70%&lt;/b&gt;.&lt;br/&gt;• &lt;b&gt;Líder Base en Discriminación Global:&lt;/b&gt;&lt;br/&gt;  &lt;span style=&quot;color:#4338CA; font-weight:700;&quot;&gt;AUC = 0.7333 | p@50 = 69.08%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1513" y="505" width="413" height="130" as="geometry" /></mxCell><mxCell id="node_150" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #4F46E5; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #4338CA;&quot;&gt;🌳 4.4 Random Forest (Bagging)&lt;/span&gt;&lt;span style=&quot;background: #E0E7FF; color: #3730A3; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Varianza&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Ensamble bagging de 200 árboles de decisión ortogonales.&lt;br/&gt;• AUC: &lt;b&gt;0.7282&lt;/b&gt; | p@100: &lt;b&gt;61.00%&lt;/b&gt;.&lt;br/&gt;• Brier Score: &lt;b&gt;0.1037&lt;/b&gt; (empata con LightGBM).&lt;br/&gt;• Mayor brecha sobreajuste train-val (+0.0814).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1513" y="650" width="413" height="130" as="geometry" /></mxCell><mxCell id="node_151" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #4F46E5; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #4338CA;&quot;&gt;📊 4.5 Diversidad Algorítmica&lt;/span&gt;&lt;span style=&quot;background: #E0E7FF; color: #3730A3; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Spearman ρ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;&lt;b&gt;Correlación de Rangos entre Predicciones:&lt;/b&gt;&lt;br/&gt;• CatBoost vs. LightGBM: ρ = 0.941 | CatBoost vs. XGBoost: ρ = 0.923&lt;br/&gt;• CatBoost vs. RF: ρ = 0.887 | LightGBM vs. XGBoost: ρ = 0.938&lt;br/&gt;• &lt;i&gt;Alta calidad individual combinada con errores no correlacionados: base teórica del ensamble.&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1513" y="795" width="413" height="150" as="geometry" /></mxCell><mxCell id="node_152" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #4F46E5; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #4338CA;&quot;&gt;🔢 4.6 Vector de Salida Nivel 1&lt;/span&gt;&lt;span style=&quot;background: #E0E7FF; color: #3730A3; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;P ∈ [0,1]⁴&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;• Vector cuatridimensional de probabilidades de cambio:&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 3px 0; font-weight: 600; background: #EEF2FF; padding: 3px; border-radius: 4px; font-size: 10px;&quot;&gt;&lt;b&gt;P&lt;/b&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; = [&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Cat&lt;/sub&gt;, &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Lgb&lt;/sub&gt;, &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Xgb&lt;/sub&gt;, &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;RF&lt;/sub&gt;]&lt;sup&gt;T&lt;/sup&gt;&lt;/div&gt;• Insumo directo para los meta-modelos de ensamblaje.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1513" y="960" width="413" height="145" as="geometry" /></mxCell><mxCell id="node_153" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 4px;&quot;&gt;&lt;div style=&quot;font-weight: 700; color: #4338CA; font-size: 12px; margin-bottom: 3px;&quot;&gt;🎯 Salida: Espacio de Predicciones Nivel 1&lt;/div&gt;&lt;div style=&quot;color: #475569; font-size: 10px;&quot;&gt;Cuatro fuentes complementarias de evidencia probabilística listas para el ensamble&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;dashed=1;" parent="1" vertex="1"><mxGeometry x="1513" y="1125" width="413" height="65" as="geometry" /></mxCell><mxCell id="edge_154" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;" edge="1" parent="1" source="node_147" target="node_151"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_155" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;" edge="1" parent="1" source="node_148" target="node_151"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_156" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;" edge="1" parent="1" source="node_149" target="node_151"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_157" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;" edge="1" parent="1" source="node_150" target="node_151"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_158" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;" edge="1" parent="1" source="node_151" target="node_152"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_159" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;" edge="1" parent="1" source="node_152" target="node_153"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node_160" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #9333EA; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #6B21A8;&quot;&gt;🧪 5.1 Espacio de 39 Ensambles&lt;/span&gt;&lt;span style=&quot;background: #F3E8FF; color: #581C87; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;12 Familias&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Evaluación Exhaustiva bajo Criterio 4 de 4:&lt;/b&gt;&lt;br/&gt;• Votación Suave, Ponderada, Dura y Rank Averaging.&lt;br/&gt;• Stacking Lineal, Lasso L1, Ridge L2, ElasticNet.&lt;br/&gt;• Stacking No Negativo, No Lineal (RF Meta), Blending 20%.&lt;br/&gt;• Selección Greedy de Caruana (con y sin calibración).&lt;br/&gt;• Dynamic Selection por Grifo y Mixture of Experts (MoE).&lt;br/&gt;• &lt;i&gt;Solo 8 configuraciones de 39 lograron superar simultáneamente a los 4 individuales.&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D5FF;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1992" y="215" width="413" height="165" as="geometry" /></mxCell><mxCell id="node_161" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #9333EA; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #6B21A8;&quot;&gt;🌟 5.2 STJC: Propuesta de Tesis&lt;/span&gt;&lt;span style=&quot;background: #F3E8FF; color: #581C87; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Aporte Central&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;&lt;b&gt;Stacking Temporal Jerárquico con Contracción:&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Multiventana 3m:&lt;/b&gt; Meta-entrenamiento en 3 meses pasados purgados.&lt;br/&gt;2. &lt;b&gt;Restricción Convexa:&lt;/b&gt; &lt;i&gt;w&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; ≥ 0, &amp;nbsp; ∑ &lt;i&gt;w&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; = 1 (sin pesos negativos absurdos).&lt;br/&gt;3. &lt;b&gt;Contracción (Shrinkage \lambda=0.25):&lt;/b&gt; Resuelve multicolinealidad extrema:&lt;br/&gt;   &lt;b&gt;w&lt;/b&gt;* = 0.75 &lt;b&gt;w&lt;/b&gt; + 0.25 [0.25, 0.25, 0.25, 0.25]&lt;sup&gt;T&lt;/sup&gt;4. &lt;b&gt;Ponderación Jerárquica:&lt;/b&gt; Especialización por tipo de combustible.&lt;br/&gt;5. &lt;b&gt;Bagging Temporal:&lt;/b&gt; Promediado multiventana para control de varianza.&lt;br/&gt;&lt;div style=&quot;background: #FAF5FF; border: 1px solid #D8B4FE; border-radius: 4px; padding: 3px; margin-top: 3px; font-size: 10px; color: #581C87; font-weight: 700; text-align: center;&quot;&gt;🏆 RÉCORDS: p@50 = 70.23% | p@100 = 62.51% | Brier = 0.1031&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8B4FE;strokeWidth=2;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1992" y="395" width="413" height="255" as="geometry" /></mxCell><mxCell id="node_162" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #9333EA; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #6B21A8;&quot;&gt;🏆 5.3 Votación Suave (Producción)&lt;/span&gt;&lt;span style=&quot;background: #F3E8FF; color: #581C87; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Elegido 2026&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;&lt;b&gt;Promedio Simple Parsimonioso de Probabilidades:&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 3px 0; font-weight: 600; background: #FAF5FF; padding: 3px; border-radius: 4px; font-size: 10px;&quot;&gt;&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;final&lt;/sub&gt; = ¼ (&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Cat&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Lgb&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Xgb&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;RF&lt;/sub&gt;)&lt;/div&gt;• &lt;b&gt;Récord Absoluto de AUC: 0.7355&lt;/b&gt; (Máxima discriminación global).&lt;br/&gt;• &lt;b&gt;Cero Riesgo de Sobreajuste:&lt;/b&gt; Sin parámetros libres a estimar.&lt;br/&gt;• &lt;b&gt;0 ms Latencia de Meta-Entrenamiento:&lt;/b&gt; Algoritmo seleccionado para producción.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8B4FE;strokeWidth=2;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1992" y="665" width="413" height="195" as="geometry" /></mxCell><mxCell id="node_163" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #9333EA; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #6B21A8;&quot;&gt;📈 5.4 Auditoría Estadística Wilcoxon&lt;/span&gt;&lt;span style=&quot;background: #F3E8FF; color: #581C87; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;365 Días&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.35;&quot;&gt;&lt;b&gt;Contraste Pareado con Corrección Holm-Bonferroni:&lt;/b&gt;&lt;br/&gt;• Evaluación día a día durante los 365 días de 2025 frente a cada individual.&lt;br/&gt;• &lt;b&gt;Resultado Contundente:&lt;/b&gt; Tanto Votación Suave como STJC ganaron &lt;b&gt;16 de 16 comparaciones con p &amp;lt; 0.01&lt;/b&gt; (superioridad estadísticamente demostrada).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D5FF;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1992" y="875" width="413" height="145" as="geometry" /></mxCell><mxCell id="node_164" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px; text-align: center; padding: 4px;&quot;&gt;&lt;div style=&quot;font-weight: 700; color: #6B21A8; font-size: 11.5px; margin-bottom: 2px;&quot;&gt;🧩 Ablación de STJC Validada&lt;/div&gt;&lt;div style=&quot;color: #475569;&quot;&gt;Multiventana baja Brier (-0.0033) | Shrinkage dispara p@100 (+0.43%) | Bagging maximiza AUC&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#D8B4FE;strokeWidth=1;align=left;" parent="1" vertex="1"><mxGeometry x="1992" y="1035" width="413" height="75" as="geometry" /></mxCell><mxCell id="node_165" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 4px;&quot;&gt;&lt;div style=&quot;font-weight: 700; color: #6B21A8; font-size: 12px; margin-bottom: 3px;&quot;&gt;🎯 Salida: Probabilidad Consolidada P(cambio)&lt;/div&gt;&lt;div style=&quot;color: #475569; font-size: 10px;&quot;&gt;Score probabilístico robusto, calibrado y no colineal para cada establecimiento&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;dashed=1;" parent="1" vertex="1"><mxGeometry x="1992" y="1125" width="413" height="65" as="geometry" /></mxCell><mxCell id="edge_166" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=1.5;" edge="1" parent="1" source="node_160" target="node_161"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_167" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=1.5;" edge="1" parent="1" source="node_161" target="node_163"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_168" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=1.5;" edge="1" parent="1" source="node_162" target="node_163"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_169" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=1.5;" edge="1" parent="1" source="node_163" target="node_164"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_170" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=1.5;" edge="1" parent="1" source="node_164" target="node_165"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node_171" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #059669; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #065F46;&quot;&gt;⚙️ 6.1 Motor Batch Diario&lt;/span&gt;&lt;span style=&quot;background: #D1FAE5; color: #064E3B; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Medianoche&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Ejecución Automatizada al Cierre de Jornada:&lt;/b&gt;&lt;br/&gt;• Ingesta y actualización del panel nacional con transacciones del día.&lt;br/&gt;• Extracción vectorizada de las 29 variables por grifo activo.&lt;br/&gt;• Inferencia masiva sobre &lt;b&gt;~19,292 establecimientos&lt;/b&gt; en &amp;lt; 2 minutos.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="2471" y="215" width="413" height="155" as="geometry" /></mxCell><mxCell id="node_172" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #059669; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #065F46;&quot;&gt;📋 6.2 Priorización Top-K&lt;/span&gt;&lt;span style=&quot;background: #D1FAE5; color: #064E3B; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;Cuadrillas&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Despacho Focalizado para Fiscalizadores:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Ordenamiento:&lt;/b&gt; Ranking estricto descendente por &lt;i&gt;P&lt;/i&gt;(cambio).&lt;br/&gt;• &lt;b&gt;Top 50:&lt;/b&gt; Inspecciones de alta certeza (&lt;b&gt;70.23%&lt;/b&gt; precisión).&lt;br/&gt;• &lt;b&gt;Top 100:&lt;/b&gt; Lista operativa estándar diaria (&lt;b&gt;62.51%&lt;/b&gt; precisión).&lt;br/&gt;• &lt;b&gt;Top 250:&lt;/b&gt; Operativos nacionales masivos (&lt;b&gt;53.08%&lt;/b&gt; precisión).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="2471" y="385" width="413" height="165" as="geometry" /></mxCell><mxCell id="node_173" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #059669; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #065F46;&quot;&gt;🎖️ 6.3 Desempeño Real (2026)&lt;/span&gt;&lt;span style=&quot;background: #D1FAE5; color: #064E3B; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;262 Días&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Auditoría Operativa en el Mundo Real:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;26,200 visitas simuladas&lt;/b&gt; en el Top 100.&lt;br/&gt;• &lt;span style=&quot;color:#065F46; font-weight:700;&quot;&gt;20,539 visitas con cambio confirmado (78.39% precisión real)&lt;/span&gt;.&lt;br/&gt;• &lt;b&gt;Mes Pico (Julio 2026):&lt;/b&gt; &lt;u&gt;93.00%&lt;/u&gt; de acierto en Top 100.&lt;br/&gt;• &lt;b&gt;100% de trazabilidad física&lt;/b&gt; verificada en actas del SCOP.&lt;br/&gt;• Derrota a la regla de conteo en el &lt;b&gt;88.2% de los días&lt;/b&gt; (&lt;i&gt;p&lt;/i&gt; = 4.89 × 10&lt;sup&gt;−35&lt;/sup&gt;).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=2;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="2471" y="565" width="413" height="195" as="geometry" /></mxCell><mxCell id="node_174" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #059669; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #065F46;&quot;&gt;🎯 6.4 Prueba Ciega 'Holdout'&lt;/span&gt;&lt;span style=&quot;background: #D1FAE5; color: #064E3B; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;7,431 Grifos&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Generalización en Establecimientos Nunca Vistos (30%):&lt;/b&gt;&lt;br/&gt;• AUC en conocidos: &lt;b&gt;0.7426&lt;/b&gt; vs. AUC en nunca vistos: &lt;b&gt;&lt;u&gt;0.7439&lt;/u&gt;&lt;/b&gt;.&lt;br/&gt;• Demuestra que el modelo aprendió dinámicas estructurales de mercado y no memorizó ubicaciones comerciales.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="2471" y="775" width="413" height="160" as="geometry" /></mxCell><mxCell id="node_175" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #059669; padding-bottom: 4px; margin-bottom: 5px;&quot;&gt;&lt;span style=&quot;font-weight: 700; font-size: 12px; color: #065F46;&quot;&gt;⏱️ 6.5 Flexibilidad Logística&lt;/span&gt;&lt;span style=&quot;background: #D1FAE5; color: #064E3B; padding: 1px 6px; border-radius: 8px; font-size: 9px; font-weight: 700;&quot;&gt;3, 5 y 7 Días&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;&lt;b&gt;Robustez ante Distintos Horizontes de Supervisión:&lt;/b&gt;&lt;br/&gt;• Horizonte 3 días: &lt;b&gt;+0.0671 AUC&lt;/b&gt; vs. regla (100% meses gana).&lt;br/&gt;• Horizonte 5 días: &lt;b&gt;+0.0494 AUC&lt;/b&gt; vs. regla (100% meses gana).&lt;br/&gt;• Horizonte 7 días: &lt;b&gt;+0.0435 AUC&lt;/b&gt; vs. regla (100% meses gana).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="2471" y="950" width="413" height="160" as="geometry" /></mxCell><mxCell id="node_176" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 4px;&quot;&gt;&lt;div style=&quot;font-weight: 700; color: #065F46; font-size: 12px; margin-bottom: 3px;&quot;&gt;🛡️ Fiscalización Eficiente en Osinergmin&lt;/div&gt;&lt;div style=&quot;color: #475569; font-size: 10px;&quot;&gt;Supervisión inteligente basada en riesgo con 100% trazabilidad física auditada&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;dashed=1;" parent="1" vertex="1"><mxGeometry x="2471" y="1125" width="413" height="65" as="geometry" /></mxCell><mxCell id="edge_177" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.5;" edge="1" parent="1" source="node_171" target="node_172"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_178" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.5;" edge="1" parent="1" source="node_172" target="node_173"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_179" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.5;" edge="1" parent="1" source="node_173" target="node_174"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_180" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.5;" edge="1" parent="1" source="node_174" target="node_175"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_181" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.5;" edge="1" parent="1" source="node_175" target="node_176"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_182" value="&lt;div style=&quot;background:#FFFFFF;border:1px solid #3B82F6;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;color:#1E40AF;&quot;&gt;Panel Diario Imputado&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#3B82F6;entryX=0;entryY=0.5;exitX=1;exitY=0.5;labelBackgroundColor=none;" edge="1" parent="1" source="node_119" target="node_130"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_183" value="&lt;div style=&quot;background:#FFFFFF;border:1px solid #0D9488;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;color:#0F766E;&quot;&gt;Matriz X (29 vars) + Label Y&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#0D9488;entryX=0;entryY=0.5;exitX=1;exitY=0.5;labelBackgroundColor=none;" edge="1" parent="1" source="node_130" target="node_141"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_184" value="&lt;div style=&quot;background:#FFFFFF;border:1px solid #EA580C;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;color:#C2410C;&quot;&gt;Train 6m (balanceado) + Purga 5d&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#EA580C;entryX=0;entryY=0.5;exitX=1;exitY=0.5;labelBackgroundColor=none;" edge="1" parent="1" source="node_141" target="node_153"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_185" value="&lt;div style=&quot;background:#FFFFFF;border:1px solid #6366F1;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;color:#4338CA;&quot;&gt;Vector P ∈ [0, 1]⁴&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#6366F1;entryX=0;entryY=0.5;exitX=1;exitY=0.5;labelBackgroundColor=none;" edge="1" parent="1" source="node_153" target="node_165"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_186" value="&lt;div style=&quot;background:#FFFFFF;border:1px solid #9333EA;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;color:#6B21A8;&quot;&gt;Probabilidad Final P(cambio)&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9333EA;entryX=0;entryY=0.5;exitX=1;exitY=0.5;labelBackgroundColor=none;" edge="1" parent="1" source="node_165" target="node_176"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node_187" value="&lt;div style=&quot;display: flex; justify-content: space-around; align-items: center; font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; color: #334155; padding: 4px;&quot;&gt;&lt;div&gt;&lt;b&gt;Dataset:&lt;/b&gt; 2020–2026 (SCOP Osinergmin ~1.1 GB, 5 combustibles)&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;b&gt;Validación Temporal:&lt;/b&gt; 12 Bloques Walk-Forward 2025 (Purga 5 días)&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;b&gt;Auditoría Estadística:&lt;/b&gt; Wilcoxon pareado 365 días (Holm-Bonferroni, p &amp;lt; 0.01)&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;b&gt;Prueba Operativa 2026:&lt;/b&gt; 262 días continuos, 20,539 aciertos en Top 100 (78.39% precisión real)&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;b&gt;Trazabilidad:&lt;/b&gt; 100% de casos verificados físicamente en campo&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="60" y="1345" width="2840" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>