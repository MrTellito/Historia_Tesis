                <mxCell id="n_106" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family: &#39;Segoe UI&#39;, Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 12px;&quot;&gt;🗄️ BD Macroeconómica&lt;/div&gt;&lt;div style=&quot;color: #334155; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Señales de Mercado&lt;/b&gt;&lt;br/&gt;• Tipo de cambio USD/PEN (BCRP)&lt;br/&gt;• Cotización WTI / Brent&lt;br/&gt;• Inflación y estacionalidad&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="175" width="220" x="600" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="n_107" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;shadow=1;align=left;spacing=8;" value="&lt;div style=&quot;font-family: &#39;Segoe UI&#39;, Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #3B82F6; padding-bottom: 3px;&quot;&gt;📥 A.1 Extracción &amp; Validación de Esquema&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;• Conexión por lotes al repositorio SCOP.&lt;br/&gt;• Tipado estricto de campos numéricos y fechas.&lt;br/&gt;• Filtrado de registros incompletos o cancelados.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="330" x="870" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="n_108" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;shadow=1;align=left;spacing=8;" value="&lt;div style=&quot;font-family: &#39;Segoe UI&#39;, Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #3B82F6; padding-bottom: 3px;&quot;&gt;🔒 A.2 Seudonimización Criptográfica&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;• Hash criptográfico &lt;b&gt;HMAC-SHA256 con sal&lt;/b&gt; sobre el código de estación (`idn`).&lt;br/&gt;• Preserva la continuidad de las series temporales por estación.&lt;br/&gt;• Garantiza secreto comercial y seguridad de datos.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="350" x="1240" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="n_109" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;shadow=1;align=left;spacing=8;" value="&lt;div style=&quot;font-family: &#39;Segoe UI&#39;, Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #1E3A8A; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #3B82F6; padding-bottom: 3px;&quot;&gt;🧹 A.3 Filtros de Integridad &amp; Calidad&lt;/div&gt;&lt;div style=&quot;color: #334155; line-height: 1.4;&quot;&gt;• Detección y remoción de errores tipográficos en precio.&lt;br/&gt;• Control de monotonicidad temporal (sin viajes al futuro).&lt;br/&gt;• Generación de log de auditoría de ingesta limpia.&lt;/div&gt;&lt;/div&gt;" vertex="1">
