<mxfile host="65bd71144e" modified="2026-10-12T13:10:00.000Z" agent="Antigravity/2.0" version="21.0.0" type="device"><diagram id="diag_metodologia_oficial" name="Flujo Metodológico Integral (SCOP - Osinergmin)"><mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n_101" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif;&quot;&gt;&lt;div style=&quot;font-size: 21px; font-weight: 800; color: #000000; text-transform: uppercase; letter-spacing: 0.5px;&quot;&gt;Arquitectura Metodológica del Sistema de Priorización SCOP (Osinergmin)&lt;/div&gt;&lt;div style=&quot;font-size: 13px; font-weight: 500; color: #000000; margin-top: 4px;&quot;&gt;Pipeline Científico End-to-End: Desde la Ingesta de Datos Masivos (2020–2026) hasta la Fiscalización Inteligente en Campo&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="20" width="2300" height="75" as="geometry" /></mxCell><mxCell id="n_102" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="115" width="2300" height="250" as="geometry" /></mxCell><mxCell id="n_103" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; font-weight: 800; color: #000000;&quot;&gt;CAPA I: FUENTES DE DATOS REGULATORIAS &amp; PIPELINE DE INGESTA PRIMARIA (2020–2026)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="101" width="580" height="28" as="geometry" /></mxCell><mxCell id="n_104" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; padding: 4px 6px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 4px; display: flex; align-items: center; gap: 4px;&quot;&gt;📊 &lt;b&gt;21 Libros Excel SCOP&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.35;&quot;&gt;• &lt;b&gt;Archivos .xlsx brutos&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;15.1M&lt;/b&gt; transacciones&lt;br/&gt;• Marzo 2020 – Set. 2026&lt;br/&gt;• 5 familias combustibles&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=4;" parent="1" vertex="1"><mxGeometry x="85" y="150" width="210" height="180" as="geometry" /></mxCell><mxCell id="n_105" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;🗄️ Precios Mayoristas&lt;/div&gt;&lt;div style=&quot;color: #000000; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Costos Ex-Planta&lt;/b&gt;&lt;br/&gt;• Petroperú y Refinerías&lt;br/&gt;• Listas semanales oficiales&lt;br/&gt;• Señal upstream de costos&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="325" y="150" width="200" height="180" as="geometry" /></mxCell><mxCell id="n_106" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;🗄️ Macroeconómica&lt;/div&gt;&lt;div style=&quot;color: #000000; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Señales de Mercado&lt;/b&gt;&lt;br/&gt;• Tipo de cambio BCRP&lt;br/&gt;• Cotización WTI / Brent&lt;br/&gt;• Shocks internacionales&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="555" y="150" width="200" height="180" as="geometry" /></mxCell><mxCell id="n_107" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;📥 1.1 Extracción &amp; Esquema&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.4;&quot;&gt;• Parsing masivo de libros Excel.&lt;br/&gt;• Tipado estricto de fechas y precios.&lt;br/&gt;• Filtrado de registros cancelados.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="805" y="160" width="280" height="160" as="geometry" /></mxCell><mxCell id="n_108" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;🔒 1.2 Hash Criptográfico&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.4;&quot;&gt;• &lt;b&gt;HMAC-SHA256 con sal&lt;/b&gt; sobre &lt;code&gt;idn&lt;/code&gt;.&lt;br/&gt;• Preserva series por establecimiento.&lt;br/&gt;• Blindaje de secreto comercial.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1125" y="160" width="290" height="160" as="geometry" /></mxCell><mxCell id="n_109" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;🧹 1.3 Calidad &amp; Monotonicidad&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.4;&quot;&gt;• Limpieza de outliers tipográficos.&lt;br/&gt;• Monotonicidad temporal estricta.&lt;br/&gt;• Log de auditoría de transacciones.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1455" y="160" width="290" height="160" as="geometry" /></mxCell><mxCell id="n_110" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;🗄️ Staging Limpio&lt;/div&gt;&lt;div style=&quot;color: #000000; margin-top: 4px; font-size: 10px;&quot;&gt;Transacciones limpias seudonimizadas en formato Parquet&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="1795" y="150" width="210" height="180" as="geometry" /></mxCell><mxCell id="n_111" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 6px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;✅ Ingesta Auditada&lt;/div&gt;&lt;div style=&quot;color: #000000; font-size: 10px; margin-top: 3px;&quot;&gt;15.1M filas limpias listas para modelado panel&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;dashed=1;" parent="1" vertex="1"><mxGeometry x="2055" y="195" width="260" height="90" as="geometry" /></mxCell><mxCell id="e_112" value="15.1M Filas"