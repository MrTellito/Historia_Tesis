<mxfile host="65bd71144e" modified="2026-10-12T13:10:00.000Z" agent="Antigravity/2.0" version="21.0.0" type="device"><diagram id="diag_metodologia_oficial" name="Flujo Metodológico Integral (SCOP - Osinergmin)"><mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n_101" value="&lt;div style=&quot;text-align: center; font-family: 'Segoe UI', Arial, sans-serif;&quot;&gt;&lt;div style=&quot;font-size: 21px; font-weight: 800; color: #000000; text-transform: uppercase; letter-spacing: 0.5px;&quot;&gt;Arquitectura Metodológica del Sistema de Priorización SCOP (Osinergmin)&lt;/div&gt;&lt;div style=&quot;font-size: 13px; font-weight: 500; color: #000000; margin-top: 4px;&quot;&gt;Pipeline Científico End-to-End: Desde la Ingesta de Datos Masivos (2020–2026) hasta la Fiscalización Inteligente en Campo&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="20" width="2300" height="75" as="geometry" /></mxCell><mxCell id="n_102" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="115" width="2300" height="250" as="geometry" /></mxCell><mxCell id="n_103" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; font-weight: 800; color: #000000;&quot;&gt;CAPA I: FUENTES DE DATOS REGULATORIAS &amp; PIPELINE DE INGESTA PRIMARIA (2020–2026)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="101" width="580" height="28" as="geometry" /></mxCell><mxCell id="n_104" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; padding: 4px 6px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 4px; display: flex; align-items: center; gap: 4px;&quot;&gt;&lt;b&gt;21 Libros Excel SCOP&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.35;&quot;&gt;• &lt;b&gt;Archivos .xlsx brutos&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;15.1M&lt;/b&gt; transacciones&lt;br/&gt;• Marzo 2020 – Set. 2026&lt;br/&gt;• 5 familias combustibles&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=4;" parent="1" vertex="1"><mxGeometry x="85" y="150" width="210" height="180" as="geometry" /></mxCell><mxCell id="n_105" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;Precios Mayoristas&lt;/div&gt;&lt;div style=&quot;color: #000000; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Costos Ex-Planta&lt;/b&gt;&lt;br/&gt;• Petroperú y Refinerías&lt;br/&gt;• Listas semanales oficiales&lt;br/&gt;• Señal upstream de costos&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="325" y="150" width="200" height="180" as="geometry" /></mxCell><mxCell id="n_106" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;Variables Macroeconómicas&lt;/div&gt;&lt;div style=&quot;color: #000000; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Señales de Mercado&lt;/b&gt;&lt;br/&gt;• Tipo de cambio BCRP&lt;br/&gt;• Cotización WTI / Brent&lt;br/&gt;• Shocks internacionales&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="555" y="150" width="200" height="180" as="geometry" /></mxCell><mxCell id="n_107" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;1.1 Extracción &amp; Esquema Relacional&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.4;&quot;&gt;• Parsing masivo de libros Excel.&lt;br/&gt;• Tipado estricto de fechas y precios.&lt;br/&gt;• Filtrado de registros cancelados.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="805" y="160" width="280" height="160" as="geometry" /></mxCell><mxCell id="n_108" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;1.2 Seudonimización &amp; Privacidad&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.4;&quot;&gt;• &lt;b&gt;HMAC-SHA256 con sal&lt;/b&gt; sobre &lt;code&gt;idn&lt;/code&gt;.&lt;br/&gt;• Preserva series por establecimiento.&lt;br/&gt;• Blindaje de secreto comercial.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1125" y="160" width="290" height="160" as="geometry" /></mxCell><mxCell id="n_109" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;1.3 Control de Calidad &amp; Consistencia&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.4;&quot;&gt;• Limpieza de outliers tipográficos.&lt;br/&gt;• Monotonicidad temporal estricta.&lt;br/&gt;• Log de auditoría de transacciones.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1455" y="160" width="290" height="160" as="geometry" /></mxCell><mxCell id="n_110" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;Almacén Staging Limpio&lt;/div&gt;&lt;div style=&quot;color: #000000; margin-top: 4px; font-size: 10px;&quot;&gt;Transacciones tabulares seudonimizadas en formato Parquet&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="1795" y="150" width="210" height="180" as="geometry" /></mxCell><mxCell id="n_111" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 6px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;Ingesta Auditada&lt;/div&gt;&lt;div style=&quot;color: #000000; font-size: 10px; margin-top: 3px;&quot;&gt;15.1M registros transaccionales listos para consolidación de panel&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;dashed=1;" parent="1" vertex="1"><mxGeometry x="2055" y="195" width="260" height="90" as="geometry" /></mxCell><mxCell id="e_112" value="15.1M Filas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#3B82F6;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="n_104" target="n_107"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_113" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#3B82F6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_105" target="n_107"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_114" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#3B82F6;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="n_106" target="n_107"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_115" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#3B82F6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_107" target="n_108"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#3B82F6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_108" target="n_109"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_117" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#2563EB;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_109" target="n_110"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_118" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#2563EB;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_110" target="n_111"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_119" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="395" width="2300" height="330" as="geometry" /></mxCell><mxCell id="n_120" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; font-weight: 800; color: #000000;&quot;&gt;CAPA II: PANEL LONGITUDINAL &amp; INGENIERÍA DE 29 CARACTERÍSTICAS&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="381" width="580" height="28" as="geometry" /></mxCell><mxCell id="n_121" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;2.1 Malla Cartesiana Diaria&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• &lt;code&gt;[Grifo × Combustible × Día]&lt;/code&gt; (&lt;b&gt;39.1M&lt;/b&gt; obs).&lt;br/&gt;• &lt;b&gt;Regla Forward-Fill:&lt;/b&gt; Si hoy no reportó, se imputa el último precio oficial vigente.&lt;br/&gt;• Modela la realidad física del tótem del grifo.&lt;br/&gt;• Universo activo: &lt;b&gt;~19,292 grifos diarios&lt;/b&gt;.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="85" y="435" width="330" height="250" as="geometry" /></mxCell><mxCell id="n_122" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;2.2 Definición de Target &amp; Purga&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• &lt;b&gt;Variable Binaria Objetivo:&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 4px 0; background: #FFFFFF; padding: 4px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #000000;&quot;&gt;&lt;i&gt;Y&lt;sub&gt;i,t&lt;/sub&gt;&lt;/i&gt; = 1 si cambia en horizonte &lt;i&gt;H&lt;/i&gt; = 5 días; 0 en caso contrario&lt;/div&gt;• &lt;b&gt;Purga Temporal de 6 D&#237;as (H + 1):&lt;/b&gt; Margen ciego (fecha_eval - 6d) entre train y test.&lt;br/&gt;• Elimina 100% de solapamiento (cero &lt;i&gt;data leakage&lt;/i&gt;).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="445" y="435" width="340" height="250" as="geometry" /></mxCell><mxCell id="n_123" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 11px; border-bottom: 1px solid #000000; padding-bottom: 2px; margin-bottom: 3px;&quot;&gt;Dinámica &amp; Inercia Histórica (10 vars)&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.3;&quot;&gt;• &lt;code&gt;dias_desde_ult_cambio&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;n_cambios_7&lt;/code&gt;, &lt;code&gt;14&lt;/code&gt;, &lt;code&gt;28&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;var_precio_7d&lt;/code&gt;, &lt;code&gt;28d&lt;/code&gt; | &lt;code&gt;desv_28d&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Hazard rate ('despertador')&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="815" y="435" width="265" height="118" as="geometry" /></mxCell><mxCell id="n_124" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 11px; border-bottom: 1px solid #000000; padding-bottom: 2px; margin-bottom: 3px;&quot;&gt;Competencia Espacial &amp; Mercado (8 vars)&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.3;&quot;&gt;• Δ&lt;i&gt;P&lt;/i&gt; = &lt;i&gt;P&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; − Mediana(Vecinos)&lt;br/&gt;• &lt;code&gt;n_competidores_1km&lt;/code&gt;, &lt;code&gt;3km&lt;/code&gt;, &lt;code&gt;5km&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;dist_min_competidor&lt;/code&gt;&lt;br/&gt;• Percentil y dispersión distrital&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="815" y="567" width="265" height="118" as="geometry" /></mxCell><mxCell id="n_125" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 11px; border-bottom: 1px solid #000000; padding-bottom: 2px; margin-bottom: 3px;&quot;&gt;Señales Mayoristas &amp; Transmisión (6 vars)&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.3;&quot;&gt;• Costo ex-planta Petroperú&lt;br/&gt;• &lt;code&gt;margen_bruto_estimado&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;delta_precio_planta_7d&lt;/code&gt;&lt;br/&gt;• Tipo de cambio USD/PEN | WTI&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="1105" y="435" width="265" height="118" as="geometry" /></mxCell><mxCell id="n_126" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 11px; border-bottom: 1px solid #000000; padding-bottom: 2px; margin-bottom: 3px;&quot;&gt;Estructurales &amp; Contexto (5 vars)&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.3;&quot;&gt;• &lt;code&gt;combustible_code&lt;/code&gt; (5 familias)&lt;br/&gt;• &lt;code&gt;actividad_code&lt;/code&gt; (Estación, Puesto)&lt;br/&gt;• Departamento / Región económica&lt;br/&gt;• Coordenadas UTM y clúster&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="1105" y="567" width="265" height="118" as="geometry" /></mxCell><mxCell id="n_127" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;2.3 Diagnóstico de Colinealidad &amp; VIF&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• &lt;b&gt;Factor Inflación Varianza:&lt;/b&gt; VIF &amp;lt; 5 en continuas.&lt;br/&gt;• &lt;b&gt;Colinealidad Cruzada:&lt;/b&gt; |&lt;i&gt;r&lt;/i&gt;| &amp;lt; 0.85 entre pares.&lt;br/&gt;• Vector analítico óptimo sin degradación de gradientes.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1400" y="435" width="310" height="250" as="geometry" /></mxCell><mxCell id="n_128" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;Almacén Feature Store&lt;/div&gt;&lt;div style=&quot;color: #000000; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Matriz de Características&lt;/b&gt;&lt;br/&gt;• Matriz &lt;b&gt;X&lt;/b&gt; ∈ ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt; × 29&lt;/sup&gt;&lt;br/&gt;• Etiqueta &lt;i&gt;Y&lt;sub&gt;i,t&lt;/sub&gt;&lt;/i&gt; ∈ {0, 1}&lt;br/&gt;• Formato Parquet particionado&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="1745" y="450" width="215" height="220" as="geometry" /></mxCell><mxCell id="n_129" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 6px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;Matriz Analítica Consolidada&lt;/div&gt;&lt;div style=&quot;color: #000000; font-size: 10px; margin-top: 3px;&quot;&gt;39.1M de observaciones con 29 covariables y etiqueta sin fuga temporal&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;dashed=1;" parent="1" vertex="1"><mxGeometry x="1995" y="510" width="250" height="95" as="geometry" /></mxCell><mxCell id="e_130" value="Panel Base" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0D9488;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n_110" target="n_121"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1900" y="380" /><mxPoint x="250" y="380" /></Array></mxGeometry></mxCell><mxCell id="e_131" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0D9488;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_121" target="n_122"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_132" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#14B8A6;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_122" target="n_123"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_133" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#14B8A6;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_122" target="n_124"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_134" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#14B8A6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_123" target="n_125"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#14B8A6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_124" target="n_126"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_136" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#0D9488;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="n_125" target="n_127"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_137" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#0D9488;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="n_126" target="n_127"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_138" value="29 Características" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0D9488;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_127" target="n_128"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_139" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#0D9488;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_128" target="n_129"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_140" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="745" width="2300" height="345" as="geometry" /></mxCell><mxCell id="n_141" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; font-weight: 800; color: #000000;&quot;&gt;CAPA III: PROTOCOLO TEMPORAL WALK-FORWARD &amp; MODELOS BASE (NIVEL 0)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="731" width="600" height="28" as="geometry" /></mxCell><mxCell id="n_142" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;3.1 Protocolo Walk-Forward (12 Bloques 2025)&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• &lt;b&gt;Ventana de Entrenamiento:&lt;/b&gt; 6 meses continuos rodantes (180 días).&lt;br/&gt;• &lt;b&gt;Evaluación Fuera de Muestra:&lt;/b&gt; 1 mes calendario evaluado día a día.&lt;br/&gt;• Se desplaza mes a mes a lo largo de todo el año 2025.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="85" y="785" width="310" height="265" as="geometry" /></mxCell><mxCell id="n_143" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;3.2 Purga Temporal de 6 Días (H + 1)&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• &lt;b&gt;Brecha ciega obligatoria:&lt;/b&gt;&lt;br/&gt;  Margen de 6 d&#237;as (&lt;i&gt;H&lt;/i&gt; + 1) antes del inicio del mes evaluado.&lt;br/&gt;• &lt;b&gt;Elimina 100% de solapamiento&lt;/b&gt; de la etiqueta objetivo.&lt;br/&gt;• Cero filtración del futuro (*data leakage*).&lt;/div&gt;&lt;/div&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="425" y="785" width="260" height="265" as="geometry" /></mxCell><mxCell id="n_144" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;3.3 Experimentación de Balanceo &amp; Corrección de Prior&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.4;&quot;&gt;• Submuestreo balanceado 1:1 en train (&lt;i&gt;N&lt;/i&gt; = 100k filas/bloque).&lt;br/&gt;• &lt;b&gt;Calibración Analítica en Logit:&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 3px 0; background: #FFFFFF; padding: 3px; border-radius: 4px; font-size: 10.5px; font-weight: 600; color: #000000;&quot;&gt;logit(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;real&lt;/sub&gt;) = logit(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;sub&lt;/sub&gt;) − ln(β), &amp;nbsp; β = ȳ&lt;sub&gt;entreno&lt;/sub&gt; / ȳ&lt;sub&gt;real&lt;/sub&gt;&lt;/div&gt;• Restaura el nivel medio real sin alterar el ranking (AUC idéntico).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="715" y="785" width="310" height="265" as="geometry" /></mxCell><mxCell id="n_145" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 11px; border-bottom: 1px solid #000000; padding-bottom: 2px; margin-bottom: 3px;&quot;&gt;CatBoost Classifier&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.3;&quot;&gt;• Árboles simétricos (oblivious trees)&lt;br/&gt;• Manejo nativo de covariables categóricas&lt;br/&gt;• Regularización L2 sobre particiones&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="1055" y="785" width="255" height="125" as="geometry" /></mxCell><mxCell id="n_146" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 11px; border-bottom: 1px solid #000000; padding-bottom: 2px; margin-bottom: 3px;&quot;&gt;LightGBM Classifier&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.3;&quot;&gt;• Crecimiento por hoja (leaf-wise)&lt;br/&gt;• Binning de histogramas continuos (GOSS)&lt;br/&gt;• Optimización de gradientes de alta velocidad&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="1055" y="925" width="255" height="125" as="geometry" /></mxCell><mxCell id="n_147" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 11px; border-bottom: 1px solid #000000; padding-bottom: 2px; margin-bottom: 3px;&quot;&gt;XGBoost Classifier&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.3;&quot;&gt;• Crecimiento por nivel (depth-wise)&lt;br/&gt;• Penalización analítica simultánea L1 y L2&lt;br/&gt;• Submuestreo estocástico de filas y columnas&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="1335" y="785" width="255" height="125" as="geometry" /></mxCell><mxCell id="n_148" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 10.5px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 11px; border-bottom: 1px solid #000000; padding-bottom: 2px; margin-bottom: 3px;&quot;&gt;Random Forest Classifier&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.3;&quot;&gt;• Ensamble paralelo no correlacionado (Bagging)&lt;br/&gt;• 300 estimadores independientes con bootstrap&lt;br/&gt;• Reducción de varianza estocástica&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=6;" parent="1" vertex="1"><mxGeometry x="1335" y="925" width="255" height="125" as="geometry" /></mxCell><mxCell id="n_149" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;3.4 Vector de Predicciones (Nivel 0)&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• &lt;b&gt;Vector Nivel 0:&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 3px 0; background: #FFFFFF; padding: 4px; border-radius: 4px; font-size: 10.5px; font-weight: 600; color: #000000;&quot;&gt;&lt;b&gt;P&lt;/b&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; = [&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Cat&lt;/sub&gt;, &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Lgb&lt;/sub&gt;, &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Xgb&lt;/sub&gt;, &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;RF&lt;/sub&gt;] ∈ [0, 1]&lt;sup&gt;4&lt;/sup&gt;&lt;/div&gt;• Dos esquemas de inferencia: Out-of-Fold y temporal.&lt;br/&gt;• Evaluación de diversidad y complementariedad de errores.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1625" y="785" width="300" height="265" as="geometry" /></mxCell><mxCell id="n_150" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;3.5 Contraste de Significancia Estadística&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• Prueba pareada de rangos de Wilcoxon (365 días).&lt;br/&gt;• Control de falso descubrimiento (Holm-Bonferroni).&lt;br/&gt;• Verificación de hipótesis de superioridad estadística.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1955" y="785" width="310" height="265" as="geometry" /></mxCell><mxCell id="e_151" value="Features X" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#EA580C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n_128" target="n_142"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1850" y="730" /><mxPoint x="240" y="730" /></Array></mxGeometry></mxCell><mxCell id="e_152" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#EA580C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_142" target="n_143"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_153" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#EA580C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_143" target="n_144"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_154" value="Train 1:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6366F1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_144" target="n_145"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_155" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6366F1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_144" target="n_146"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_156" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#6366F1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_145" target="n_147"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_157" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#6366F1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_146" target="n_148"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_158" value="Probabilidades" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6366F1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="n_147" target="n_149"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_159" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6366F1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="n_148" target="n_149"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_160" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6366F1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_149" target="n_150"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_161" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="1110" width="2300" height="330" as="geometry" /></mxCell><mxCell id="n_162" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; font-weight: 800; color: #000000;&quot;&gt;CAPA IV: META-APRENDIZAJE DE NIVEL 1, APORTE DE TESIS (STJC) &amp; MODEL REGISTRY&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="1096" width="600" height="28" as="geometry" /></mxCell><mxCell id="n_163" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;4.1 Espacio de 39 Ensambles Evaluados&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.4;&quot;&gt;• Votación Suave, Ponderada, Dura, Rank.&lt;br/&gt;• Stacking Ridge, Lasso, ElasticNet, Non-Neg.&lt;br/&gt;• Caruana Greedy, Meta-RF, Blending 20%.&lt;br/&gt;• Dynamic Selection por Grifo y MoE.&lt;br/&gt;• Criterio multicriterio: superar a individuales en AUC, p@100, p@250 y Brier.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="85" y="1150" width="340" height="250" as="geometry" /></mxCell><mxCell id="n_164" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #000000; padding-bottom: 4px; margin-bottom: 6px;&quot;&gt;&lt;span style=&quot;font-weight: 800; color: #000000; font-size: 12.5px;&quot;&gt;4.2 Método Propuesto: Stacking Temporal Jerárquico con Contracción (STJC)&lt;/span&gt;&lt;span style=&quot;background: #FFFFFF; color: #000000; padding: 2px 8px; border-radius: 8px; font-weight: 800; font-size: 10px;&quot;&gt;Aporte de Tesis&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.4;&quot;&gt;1. &lt;b&gt;Multiventana Temporal (3 meses):&lt;/b&gt; Meta-entrenamiento en ventanas históricas purgadas.&lt;br/&gt;2. &lt;b&gt;Restricción Convexa:&lt;/b&gt; &lt;i&gt;w&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; ≥ 0, &amp;nbsp; ∑ &lt;i&gt;w&lt;sub&gt;m&lt;/sub&gt;&lt;/i&gt; = 1 (sin pesos negativos inestables).&lt;br/&gt;3. &lt;b&gt;Contracción Analítica (Shrinkage λ = 0.25):&lt;/b&gt; Resuelve multicolinealidad extrema:&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 3px 0; background: #FFFFFF; padding: 3px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #000000;&quot;&gt;&lt;b&gt;w&lt;/b&gt;* = (1 − λ) &lt;b&gt;w&lt;/b&gt; + λ [0.25, 0.25, 0.25, 0.25]&lt;sup&gt;T&lt;/sup&gt;&lt;/div&gt;4. &lt;b&gt;Ponderación Jerárquica:&lt;/b&gt; Especialización por familia de combustible.&lt;br/&gt;5. &lt;b&gt;Bagging Temporal:&lt;/b&gt; Promediado de ventanas para mitigación de varianza.&lt;br/&gt;&lt;div style=&quot;background: #FFFFFF; border: 1.5px solid #000000; border-radius: 4px; padding: 4px; margin-top: 4px; font-size: 11px; color: #000000; font-weight: 800; text-align: center;&quot;&gt;Objetivo Metodológico: Optimización del ordenamiento Top-K bajo deriva de mercado&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="460" y="1145" width="620" height="265" as="geometry" /></mxCell><mxCell id="n_165" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #000000; padding-bottom: 4px; margin-bottom: 6px;&quot;&gt;&lt;span style=&quot;font-weight: 800; color: #000000; font-size: 12.5px;&quot;&gt;4.3 Votación Suave Equi-Ponderada&lt;/span&gt;&lt;span style=&quot;background: #FFFFFF; color: #000000; padding: 2px 8px; border-radius: 8px; font-weight: 800; font-size: 10px;&quot;&gt;Despliegue 2026&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.4;&quot;&gt;&lt;b&gt;Promedio Simple Parsimonioso:&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: center; margin: 4px 0; background: #FFFFFF; padding: 4px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #000000;&quot;&gt;&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;final&lt;/sub&gt; = ¼ (&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Cat&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Lgb&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;Xgb&lt;/sub&gt; + &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;RF&lt;/sub&gt;)&lt;/div&gt;• Regla de combinación no paramétrica de referencia.&lt;br/&gt;• Ausencia de hiperparámetros de meta-entrenamiento.&lt;br/&gt;• Latencia mínima para inferencia analítica diaria.&lt;br/&gt;• Evaluación en paralelo frente a métodos ponderados.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1115" y="1150" width="430" height="250" as="geometry" /></mxCell><mxCell id="n_166" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding-top: 15px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;Almacén Model Registry&lt;/div&gt;&lt;div style=&quot;color: #000000; margin-top: 4px; line-height: 1.35;&quot;&gt;&lt;b&gt;Almacén de Modelos&lt;/b&gt;&lt;br/&gt;• Pesos serializados (&lt;code&gt;.joblib&lt;/code&gt;)&lt;br/&gt;• Pipelines calibrados&lt;br/&gt;• Versiones y metadatos&lt;br/&gt;• Reentrenamiento trimestral&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="1580" y="1160" width="225" height="230" as="geometry" /></mxCell><mxCell id="n_167" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; text-align: center; padding: 6px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px;&quot;&gt;Modelo para Inferencia Diaria&lt;/div&gt;&lt;div style=&quot;color: #000000; font-size: 10px; margin-top: 3px;&quot;&gt;Probabilidad final &lt;i&gt;P&lt;/i&gt;(cambio) lista para inferencia nocturna&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;dashed=1;" parent="1" vertex="1"><mxGeometry x="1845" y="1225" width="260" height="100" as="geometry" /></mxCell><mxCell id="e_168" value="Vector P_t" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333EA;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n_149" target="n_163"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1775" y="1095" /><mxPoint x="255" y="1095" /></Array></mxGeometry></mxCell><mxCell id="e_169" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333EA;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_163" target="n_164"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_170" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333EA;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_164" target="n_165"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_171" value="Artefactos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333EA;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_165" target="n_166"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_172" value="Modelo Producción" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333EA;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_166" target="n_167"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_173" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="1465" width="2300" height="310" as="geometry" /></mxCell><mxCell id="n_174" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; font-weight: 800; color: #000000;&quot;&gt;CAPA V: MOTOR DE INFERENCIA EN BATCH, PRIORIZACIÓN TOP-K &amp; FISCALIZACIÓN EN CAMPO (2026)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=center;" parent="1" vertex="1"><mxGeometry x="75" y="1451" width="690" height="28" as="geometry" /></mxCell><mxCell id="n_175" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;5.1 Pipeline de Inferencia Diaria&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• Disparo automático tras cierre diario oficial del SCOP (00:00).&lt;br/&gt;• Actualización inmediata del panel.&lt;br/&gt;• Extracción vectorizada de 29 variables.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="85" y="1505" width="310" height="230" as="geometry" /></mxCell><mxCell id="n_176" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;5.2 Motor de Scoring Probabilístico&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• Scoring probabilístico sobre la totalidad de grifos activos.&lt;br/&gt;• Estimación de P(cambio | X_t) con calibración isotónica.&lt;br/&gt;• Asignación de &lt;i&gt;P&lt;/i&gt;(cambio | &lt;b&gt;X&lt;/b&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt;).&lt;br/&gt;• Orden descendente en cola de prioridad.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="430" y="1505" width="350" height="230" as="geometry" /></mxCell><mxCell id="n_177" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;5.3 Generación de Listas de Priorización Top-K&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• &lt;b&gt;Top 50:&lt;/b&gt; Umbral de inspección de máxima certeza operativa.&lt;br/&gt;• &lt;b&gt;Top 100:&lt;/b&gt; Cuota estándar diaria para fiscalización focalizada.&lt;br/&gt;• &lt;b&gt;Top 250:&lt;/b&gt; Umbral ampliado para operativos regionales masivos.&lt;br/&gt;• Despacho automatizado a fiscalizadores en territorio.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="815" y="1505" width="375" height="230" as="geometry" /></mxCell><mxCell id="n_178" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;5.4 Protocolo de Validación en Periodo de Prueba (2026)&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• Evaluación ciega fuera de muestra durante 262 días del año 2026.&lt;br/&gt;• Simulación de fiscalización diaria en las listas Top-K.&lt;br/&gt;• Contraste objetivo frente a actas oficiales registradas en el SCOP.&lt;br/&gt;• Evaluación de generalización en 30% de grifos 'nunca vistos'.&lt;br/&gt;• Monitoreo de resiliencia frente al quiebre de precios de marzo.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1225" y="1500" width="520" height="240" as="geometry" /></mxCell><mxCell id="n_179" value="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px;&quot;&gt;&lt;div style=&quot;font-weight: 800; color: #000000; font-size: 12px; margin-bottom: 5px; border-bottom: 1.5px solid #000000; padding-bottom: 3px;&quot;&gt;5.5 Evaluación de Eficiencia Regulatoria&lt;/div&gt;&lt;div style=&quot;color: #000000; line-height: 1.45;&quot;&gt;• Supervisión inteligente orientada a riesgo.&lt;br/&gt;• Reducción drástica de inspecciones fallidas.&lt;br/&gt;• Mayor disuasión frente a especulación.&lt;br/&gt;• Eficiencia máxima del gasto público.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1780" y="1505" width="340" height="230" as="geometry" /></mxCell><mxCell id="e_180" value="Modelo Desplegado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n_167" target="n_175"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1975" y="1450" /><mxPoint x="240" y="1450" /></Array></mxGeometry></mxCell><mxCell id="e_181" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_175" target="n_176"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_182" value="Scores P" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_176" target="n_177"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_183" value="Listas Diarias" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_177" target="n_178"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_184" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_178" target="n_179"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_185" value="&lt;div style=&quot;background:#FFFFFF;border:1.5px solid #0D9488;padding:3px 10px;border-radius:6px;font-size:10px;font-weight:700;color:#0F766E;&quot;&gt;Bucle de Retroalimentación Operativa (Reentrenamiento Trimestral &amp; Monitoreo de Deriva)&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeWidth=2.5;strokeColor=#0D9488;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_178" target="n_142"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1485" y="1795" /><mxPoint x="35" y="1795" /><mxPoint x="35" y="915" /></Array></mxGeometry></mxCell><mxCell id="n_186" value="&lt;div style=&quot;display: flex; justify-content: space-around; align-items: center; font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; color: #000000; padding: 4px;&quot;&gt;&lt;div&gt;&lt;b&gt;LEYENDA:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Documento / Archivo:&lt;/b&gt; Archivos Excel Masivos del SCOP&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;b&gt;Cilindro:&lt;/b&gt; Base de Datos / Almacén Persistente&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;b&gt;Caja de Proceso:&lt;/b&gt; Componente de Procesamiento de Pipeline&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;b&gt;Módulo Destacado:&lt;/b&gt; Aporte Científico de la Tesis (STJC)&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#3B82F6;&quot;&gt;━━▶&lt;/span&gt; &lt;b&gt;Flujo de Datos&lt;/b&gt;&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#6366F1;&quot;&gt;━━▶&lt;/span&gt; &lt;b&gt;Flujo de Modelado&lt;/b&gt;&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#059669;&quot;&gt;━━▶&lt;/span&gt; &lt;b&gt;Inferencia Operativa&lt;/b&gt;&lt;/div&gt;&lt;div&gt;|&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#0D9488;&quot;&gt;- - -▶&lt;/span&gt; &lt;b&gt;Bucle de Retroalimentación&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="1820" width="2300" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>