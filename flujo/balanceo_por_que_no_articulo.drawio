 de 12" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=5;spacingRight=3;verticalAlign=middle;align=center;strokeColor=#000000;strokeWidth=0.6;fillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="302.0" y="614.0" width="196.0" height="20.0" as="geometry"/></mxCell><mxCell id="v66" value="Mucho peor" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=5;spacingRight=3;verticalAlign=middle;align=center;strokeColor=#000000;strokeWidth=0.6;fillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="498.0" y="614.0" width="95.0" height="20.0" as="geometry"/></mxCell><mxCell id="v67" value="p@100: aciertos entre los 100 primeros de cada día. «Empate»: diferencias en el cuarto decimal y ventaja en alrededor de la mitad de los meses." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacingLeft=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="12.0" y="638.0" width="581.0" height="32.0" as="geometry"/></mxCell><mxCell id="v68" value="5 · Decisión" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="680.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v69" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="699.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v70" value="&lt;b&gt;La teoría permite&lt;/b&gt;&lt;br&gt;Ordenar sin exigir clases 50/50." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="708.0" width="179.0" height="80.0" as="geometry"/></mxCell><mxCell id="v71" value="&lt;b&gt;La validación respalda&lt;/b&gt;&lt;br&gt;«Sin balanceo»: 1.º de 8 (posición media 2,50); con los 4 modelos, 1.º de 4 (1,75)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="213.0" y="708.0" width="179.0" height="80.0" as="geometry"/></mxCell><mxCell id="v72" value="&lt;b&gt;Decisión del estudio&lt;/b&gt;&lt;br&gt;Entrenar con la distribución original, sin corrección de la Ec. 4." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="414.0" y="708.0" width="179.0" height="80.0" as="geometry"/></mxCell><mxCell id="e73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v70" target="v71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v71" target="v72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>