<mxfile host="Electron"><diagram id="ensambles_metodo.drawio" name="Ensambles (metodología)"><mxGraphModel dx="605" dy="726" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="605" pageHeight="726" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="1 · Cuatro modelos base entrenados con la misma ventana" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="12.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="31.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;CatBoost&lt;/b&gt;&lt;br&gt;Boosting; árboles simétricos" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="40.0" width="139.2" height="52.0" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;LightGBM&lt;/b&gt;&lt;br&gt;Boosting; crece hoja por hoja" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="159.2" y="40.0" width="139.2" height="52.0" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;XGBoost&lt;/b&gt;&lt;br&gt;Boosting; crece nivel por nivel" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="306.5" y="40.0" width="139.2" height="52.0" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Random Forest&lt;/b&gt;&lt;br&gt;Promedio de 300 árboles" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="453.8" y="40.0" width="139.2" height="52.0" as="geometry"/></mxCell><mxCell id="v7" value="Sus predicciones se parecen mucho, por lo que combinarlas solo ayuda si los pesos se estiman con cuidado." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacingLeft=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="12.0" y="96.0" width="581.0" height="32.0" as="geometry"/></mxCell><mxCell id="v8" value="2 · Cada fila recibe cuatro probabilidades (ejemplo ilustrativo)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="138.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v9" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="157.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Establecimiento X · diésel · un día cualquiera&lt;/b&gt;&lt;br&gt;CatBoost 0,40   ·   LightGBM 0,36   ·   XGBoost 0,44   ·   Random Forest 0,32" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="166.0" width="581.0" height="38.0" as="geometry"/></mxCell><mxCell id="v11" value="3 · Cómo fijan los pesos las cuatro estrategias de la Ec. 5" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="218.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v12" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="237.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Votación suave&lt;/b&gt;&lt;br&gt;Cada modelo pesa 1/4. No aprende nada.&lt;br&gt;Ej.: (0,40 + 0,36 + 0,44 + 0,32) / 4 = 0,380" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="246.0" width="285.5" height="52.0" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Votación ponderada&lt;/b&gt;&lt;br&gt;Peso proporcional al AUC de cada modelo en el último mes de la ventana." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="307.5" y="246.0" width="285.5" height="52.0" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Selección de Caruana&lt;/b&gt;&lt;br&gt;En 40 rondas agrega, con reemplazo, el modelo que más sube el AUC; el peso es la fracción de rondas en que se eligió.&lt;br&gt;Ej.: 20, 14 y 6 rondas → pesos 0,50 · 0,35 · 0,15" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="306.0" width="285.5" height="94.0" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Caruana temporal&lt;/b&gt;&lt;br&gt;Igual, pero aprende con el último mes de la ventana predicho por modelos entrenados antes de él." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="307.5" y="306.0" width="285.5" height="94.0" as="geometry"/></mxCell><mxCell id="v17" value="4 · Cómo se aprenden los pesos sin mirar el futuro" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="414.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v18" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="433.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Por establecimiento&lt;/b&gt;&lt;br&gt;Cinco pliegues; un mismo establecimiento nunca queda en dos pliegues. Predice establecimientos no vistos, pero del mismo periodo." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="442.0" width="285.5" height="80.0" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;Temporal&lt;/b&gt;&lt;br&gt;Los modelos base, entrenados hasta el mes anterior, predicen el último mes de la ventana. Reproduce el uso real: predecir días que no se vieron." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="307.5" y="442.0" width="285.5" height="80.0" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;Riesgo del stacking (Ec. 6)&lt;/b&gt;&lt;br&gt;Un metamodelo libre puede asignar pesos negativos o extremos a modelos casi idénticos; el STJC (sección 3.5) restringe y contrae esos pesos." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#F2F2F2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="528.0" width="581.0" height="52.0" as="geometry"/></mxCell><mxCell id="v22" value="5 · Regla fijada antes de ver resultados (promedio de los 12 meses de 2025)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="594.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v23" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="613.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;39 estrategias&lt;/b&gt;&lt;br&gt;10 familias, incluido el STJC, en sus versiones por establecimiento y temporal" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="622.0" width="179.0" height="94.0" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;Regla de selección&lt;/b&gt;&lt;br&gt;1) más métricas en que supera a todos los individuales; 2) mejor posición media; 3) mayor AUC" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="213.0" y="622.0" width="179.0" height="94.0" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;Ensamble elegido&lt;/b&gt;&lt;br&gt;Pasa a la prueba prospectiva de 2026" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="414.0" y="622.0" width="179.0" height="94.0" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v24" target="v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v25" target="v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>