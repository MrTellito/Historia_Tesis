<mxfile host="Electron"><diagram id="stjc_metodo.drawio" name="STJC (metodología)"><mxGraphModel dx="605" dy="626" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="605" pageHeight="626" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="1 · Aprender del pasado como si cada mes fuera nuevo" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="12.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="31.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Ventana antigua&lt;/b&gt;&lt;br&gt;Predicciones de los 4 modelos y lo que ocurrió" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="40.0" width="131.8" height="80.0" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Ventana intermedia&lt;/b&gt;&lt;br&gt;Predicciones de los 4 modelos y lo que ocurrió" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="161.8" y="40.0" width="131.8" height="80.0" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Ventana reciente&lt;/b&gt;&lt;br&gt;Elige los controles por AUC" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="311.5" y="40.0" width="131.8" height="80.0" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Mes evaluado&lt;/b&gt;&lt;br&gt;Se aplica la receta; sus respuestas no se usan para ajustarla" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="461.2" y="40.0" width="131.8" height="80.0" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v10" value="Tres ventanas de 30 días dentro de la historia de entrenamiento, cada una predicha solo con datos anteriores y separada por una purga de 6 días. Las dos antiguas ajustan candidatos, la reciente elige y, al final, los pesos se reajustan con las tres." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacingLeft=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="12.0" y="124.0" width="581.0" height="46.0" as="geometry"/></mxCell><mxCell id="v11" value="2 · Tres controles sobre los pesos" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="180.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v12" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="199.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;A. Pesos convexos&lt;/b&gt;&lt;br&gt;Pesos ≥ 0 que suman 100 %: ningún modelo resta la opinión de otro.&lt;br&gt;Ejemplo: 40 / 30 / 20 / 10 %." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="208.0" width="188.3" height="94.0" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;B. Contracción (Ec. 7)&lt;/b&gt;&lt;br&gt;Penaliza alejarse de 25 / 25 / 25 / 25 %. La fuerza λ se elige por AUC en la ventana reciente." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="208.3" y="208.0" width="188.3" height="94.0" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;C. Pesos por combustible&lt;/b&gt;&lt;br&gt;Pesos propios atraídos a los generales; solo si mejoran (≥ 2 000 filas y ambas clases)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="404.7" y="208.0" width="188.3" height="94.0" as="geometry"/></mxCell><mxCell id="v16" value="3 · Bagging temporal, solo si mejora" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="314.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v17" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="333.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v18" value="Versión completa" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="342.0" width="88.0" height="34.0" as="geometry"/></mxCell><mxCell id="v19" value="Ventana antigua" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="106.0" y="342.0" width="88.0" height="34.0" as="geometry"/></mxCell><mxCell id="v20" value="Ventana intermedia" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="200.0" y="342.0" width="88.0" height="34.0" as="geometry"/></mxCell><mxCell id="v21" value="Ventana reciente" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="294.0" y="342.0" width="88.0" height="34.0" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;Promedio de probabilidades&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="102.0" y="398.0" width="190.0" height="26.0" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v18" target="v22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="56.0" y="387.0"/><mxPoint x="197.0" y="387.0"/></Array></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v19" target="v22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150.0" y="387.0"/><mxPoint x="197.0" y="387.0"/></Array></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v20" target="v22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="244.0" y="387.0"/><mxPoint x="197.0" y="387.0"/></Array></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v21" target="v22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="338.0" y="387.0"/><mxPoint x="197.0" y="387.0"/></Array></mxGeometry></mxCell><mxCell id="v27" value="&lt;b&gt;¿Mejora el AUC interno?&lt;/b&gt;&lt;br&gt;Sí: promedio temporal; no: versión completa.&lt;br&gt;Se decide antes del mes evaluado." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="404.0" y="342.0" width="189.0" height="82.0" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="v22" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v29" value="4 · Ejemplo ilustrativo: de cuatro probabilidades a una prioridad" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="438.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v30" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="457.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v31" value="CatBoost 0,80 · peso 0,40" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="466.0" width="182.0" height="24.0" as="geometry"/></mxCell><mxCell id="v32" value="LightGBM 0,60 · peso 0,30" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="496.0" width="182.0" height="24.0" as="geometry"/></mxCell><mxCell id="v33" value="XGBoost 0,40 · peso 0,20" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="526.0" width="182.0" height="24.0" as="geometry"/></mxCell><mxCell id="v34" value="Random Forest 0,20 · peso 0,10" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="556.0" width="182.0" height="24.0" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;Combinación en escala logit&lt;/b&gt;&lt;br&gt;1. L = ln[p / (1 − p)] en cada modelo&lt;br&gt;2. z = 0,4 L(CB) + 0,3 L(LGB) + 0,2 L(XGB) + 0,1 L(RF) = 0,456&lt;br&gt;3. p = 1 / (1 + e^(−z)) = 0,612&lt;br&gt;(sin escala ni intercepto, para simplificar)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210.0" y="466.0" width="232.0" height="114.0" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v31" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v32" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v33" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v34" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v40" value="&lt;b&gt;Ordenar todos los casos&lt;/b&gt;&lt;br&gt;1. B 0,72&lt;br&gt;2. A 0,61&lt;br&gt;3. C 0,43&lt;br&gt;4. D 0,21&lt;br&gt;Con 2 cupos: B y A" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="458.0" y="466.0" width="135.0" height="114.0" as="geometry"/></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v35" target="v40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v42" value="Las probabilidades no se promedian directamente: se combinan en escala logit con los pesos aprendidos. El aporte de cada pieza se mide con una ablación (sección 3.5)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacingLeft=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="12.0" y="584.0" width="581.0" height="32.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>