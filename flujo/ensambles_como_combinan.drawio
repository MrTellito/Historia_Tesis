<mxfile host="Electron"><diagram id="ensambles_v6" name="Ensambles"><mxGraphModel dx="605" dy="896" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="605" pageHeight="896" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;1 · Cuatro modelos base entrenados con la misma ventana&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F2937;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="12" y="8" width="581" height="22" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;CatBoost&lt;/b&gt;&lt;br&gt;Boosting; árboles simétricos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E6F2F2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="40" width="139.25" height="52" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;LightGBM&lt;/b&gt;&lt;br&gt;Boosting; crece hoja por hoja" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E6F2F2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="159.25" y="40" width="139.25" height="52" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;XGBoost&lt;/b&gt;&lt;br&gt;Boosting; crece nivel por nivel" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E6F2F2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="306.5" y="40" width="139.25" height="52" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Random Forest&lt;/b&gt;&lt;br&gt;Promedio de 300 árboles" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E6F2F2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="453.75" y="40" width="139.25" height="52" as="geometry"/></mxCell><mxCell id="v6" value="Sus predicciones se parecen mucho (correlación de Spearman entre 0,91 y 0,98): combinarlas solo ayuda si se hace con cuidado." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacingLeft=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="12" y="96" width="581" height="30" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;2 · Cada fila recibe cuatro probabilidades (ejemplo ilustrativo)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F2937;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="12" y="136" width="581" height="22" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Grifo X · diésel · un día de mayo&lt;/b&gt;&lt;br&gt;CatBoost 0,40   ·   LightGBM 0,36   ·   XGBoost 0,44   ·   Random Forest 0,32" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#F3F4F6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12" y="168" width="581" height="38" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;3 · Cómo combinan los cuatro mejores ensambles (Ec. 5) y el STJC (Ec. 7)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F2937;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="12" y="220" width="581" height="22" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Votación suave&lt;/b&gt;&lt;br&gt;Promedio simple: cada modelo pesa 0,25. No aprende nada.&lt;br&gt;Ejemplo: (0,40 + 0,36 + 0,44 + 0,32) / 4 = 0,380" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#FFFFFF;strokeWidth=1;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="12.0" y="252" width="285.5" height="94" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Votación ponderada&lt;/b&gt;&lt;br&gt;Cada modelo pesa según su AUC del último mes. Como los AUC son parecidos, los pesos quedan entre 0,22 y 0,27.&lt;br&gt;Ejemplo: ≈ 0,380" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#FFFFFF;strokeWidth=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="307.5" y="252" width="285.5" height="94" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Selección de Caruana (por establecimiento)&lt;/b&gt;&lt;br&gt;En 40 rondas agrega, con reemplazo, el modelo que más sube el AUC. Pesos medios en 2025: XGBoost 0,36 y Random Forest 0,64.&lt;br&gt;Ejemplo: 0,36 × 0,44 + 0,64 × 0,32 = 0,363" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#FFFFFF;strokeWidth=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="12.0" y="354" width="285.5" height="94" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Selección de Caruana (temporal)&lt;/b&gt;&lt;br&gt;Igual, pero aprende con el último mes predicho a futuro. Pesos medios: 0,25 · 0,20 · 0,35 · 0,20.&lt;br&gt;Ejemplo: 0,100 + 0,072 + 0,154 + 0,064 = 0,390" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#FFFFFF;strokeWidth=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="307.5" y="354" width="285.5" height="94" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;STJC (método propuesto)&lt;/b&gt;&lt;br&gt;Aprende los pesos con 3 meses predichos a futuro; los pesos son ≥ 0 y suman 1; se acercan a 0,25 con la fuerza λ que mejor funcionó en el último mes; añade pesos por combustible y bagging temporal solo si mejoran. Combina en escala logit. Pesos medios en 2025: 0,20 · 0,25 · 0,24 · 0,31." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#6D28D9;fillColor=#F5F3FF;strokeWidth=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="12" y="458" width="581" height="80" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;4 · Cómo se aprenden los pesos sin mirar el futuro&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F2937;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="12" y="552" width="581" height="22" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Por establecimiento&lt;/b&gt;&lt;br&gt;Cinco pliegues; un mismo grifo nunca queda en dos pliegues. Predice grifos no vistos, pero del mismo periodo." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="584" width="285.5" height="80" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Temporal&lt;/b&gt;&lt;br&gt;Los modelos base, entrenados hasta el mes anterior, predicen el último mes de la ventana. Reproduce el uso real: predecir días que no se vieron." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="307.5" y="584" width="285.5" height="80" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Por qué importa&lt;/b&gt;&lt;br&gt;El stacking clásico por establecimiento dio peso −0,60 a LightGBM y 0,89 a Random Forest: castigaba a un buen modelo y premiaba al que peor predecía el mes siguiente. El STJC nace para evitarlo." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#B86E0A;fillColor=#FDF3E4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12" y="670" width="581" height="66" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;5 · Regla fijada antes de ver resultados (promedio de los 12 meses de 2025)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F2937;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="12" y="750" width="581" height="22" as="geometry"/></mxCell><mxCell id="v20" value="Más métricas superadas;&lt;br&gt;luego mejor posición&lt;br&gt;media en 4 métricas" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="22" y="782" width="200" height="96" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;Votación suave: 1.º de 39&lt;/b&gt;&lt;br&gt;Posición media 3,75 · pasa a la prueba de 2026" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#0F7C7A;fillColor=#E8F3EC;strokeWidth=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="248" y="781.0" width="345" height="38" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;STJC: 2.º de 39&lt;/b&gt;&lt;br&gt;Posición media 4,25 · mejor en p@100, p@250 y Brier; cara a cara empata con la votación" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#6D28D9;fillColor=#F5F3FF;strokeWidth=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="248" y="827.0" width="345" height="52" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v20" target="v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v20" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>