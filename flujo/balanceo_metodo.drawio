<mxfile host="Electron"><diagram id="balanceo_metodo.drawio" name="Balanceo (metodología)"><mxGraphModel dx="605" dy="530" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="605" pageHeight="530" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="1 · Del desbalance observado a una lista de prioridad" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="12.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="31.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Datos de entrenamiento&lt;/b&gt;&lt;br&gt;300 000 filas por mes&lt;br&gt;≈ 13 % cambian; ≈ 87 % no cambian&lt;br&gt;Cada fila: 29 variables (X) y la respuesta (y)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="40.0" width="179.0" height="94.0" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;El modelo aprende&lt;/b&gt;&lt;br&gt;Relaciona X con y y estima p, la probabilidad de que el precio cambie en los próximos 5 días." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="213.0" y="40.0" width="179.0" height="94.0" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Se eligen los K primeros&lt;/b&gt;&lt;br&gt;Ejemplo: 6 casos y 3 cupos&lt;br&gt;A 0,80 · B 0,60 · C 0,40&lt;br&gt;D 0,25 · E 0,10 · F 0,05&lt;br&gt;Se eligen A, B y C (en el estudio, K = 100)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="414.0" y="40.0" width="179.0" height="94.0" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v8" value="2 · Con cupos fijos importa el orden, no superar un umbral de 50 %" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="146.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v9" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="165.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;A + B + C: los 3 primeros&lt;/b&gt;&lt;br&gt;0,80 + 0,60 + 0,40 = 1,80 aciertos esperados" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="12.0" y="174.0" width="283.5" height="38.0" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;A + B + F: se omite el tercero&lt;/b&gt;&lt;br&gt;0,80 + 0,60 + 0,05 = 1,45 aciertos esperados" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="309.5" y="174.0" width="283.5" height="38.0" as="geometry"/></mxCell><mxCell id="v12" value="C entra con 40 %: cuenta su puesto. Aprender ese orden no exige entrenar con 50 % de cada clase; los aciertos esperados son la suma de las probabilidades elegidas (ejemplo ilustrativo)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacingLeft=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="12.0" y="216.0" width="581.0" height="32.0" as="geometry"/></mxCell><mxCell id="v13" value="3 · Qué hace cada técnica con las filas de entrenamiento" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="258.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v14" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="277.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Eliminar filas&lt;/b&gt;&lt;br&gt;Submuestreo 1:1 y 1:3; Tomek Links&lt;br&gt;Se conservan menos negativos." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="286.0" width="139.2" height="80.0" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Repetir filas&lt;/b&gt;&lt;br&gt;Sobremuestreo aleatorio&lt;br&gt;Se duplican positivos reales." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="159.2" y="286.0" width="139.2" height="80.0" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Generar filas&lt;/b&gt;&lt;br&gt;SMOTENC y ADASYN&lt;br&gt;Se interpolan las variables de dos positivos." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="306.5" y="286.0" width="139.2" height="80.0" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Cambiar pesos&lt;/b&gt;&lt;br&gt;Pesos de clase&lt;br&gt;Cada positivo pesa ≈ 6,7 veces más." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="453.8" y="286.0" width="139.2" height="80.0" as="geometry"/></mxCell><mxCell id="v19" value="Ninguna técnica cambia una respuesta real ni iguala las variables, y el mes evaluado conserva su proporción real. Si se remuestrea, las probabilidades vuelven a la proporción real con la Ec. 4." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacingLeft=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="12.0" y="370.0" width="581.0" height="32.0" as="geometry"/></mxCell><mxCell id="v20" value="4 · Cómo se decide" style="text;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;spacingLeft=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="412.0" width="581.0" height="18.0" as="geometry"/></mxCell><mxCell id="v21" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="431.0" width="581.0" height="1.0" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;8 opciones&lt;/b&gt;&lt;br&gt;Sin balanceo y 7 técnicas, todas con 300 000 filas" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="440.0" width="179.0" height="80.0" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;12 meses de 2025&lt;/b&gt;&lt;br&gt;Cada mes se evalúa con su proporción real, sin balancear" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="213.0" y="440.0" width="179.0" height="80.0" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;Regla previa&lt;/b&gt;&lt;br&gt;Mejor posición media en AUC, p@100, p@250 y Brier; las mejores se confirman con los 4 modelos" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="414.0" y="440.0" width="179.0" height="80.0" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v22" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v23" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>