 aprendizaje y prueba negativa&lt;/b&gt;&lt;br&gt;300 mil filas por competidor; etiquetas al azar: AUC 0,49" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#FFFFFF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="411" y="311" width="172" height="80" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;strokeWidth=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3_3" target="n3_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n3_5" value="&lt;b&gt;2026 reservado&lt;/b&gt;&lt;br&gt;Prueba usada una sola vez (Fase 6)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#FFFFFF;strokeWidth=1;dashed=1;fillColor=#F3F4F6;" vertex="1" parent="1"><mxGeometry x="411" y="407" width="172" height="52" as="geometry"/></mxCell><mxCell id="lane4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9CA3AF;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="12" y="496" width="186" height="404" as="geometry"/></mxCell><mxCell id="head4" value="&lt;b&gt;Fase 4 · Sección 3.4&lt;/b&gt;&lt;br&gt;Modelos base y estrategias de ensamble" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;fontSize=11;fontColor=#FFFFFF;fillColor=#1F2937;strokeColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="12" y="496" width="186" height="50" as="geometry"/></mxCell><mxCell id="n4_1" value="&lt;b&gt;4 modelos base&lt;/b&gt;&lt;br&gt;CatBoost, LightGBM, XGBoost y Random Forest" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=