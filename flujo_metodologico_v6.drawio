" parent="1" source="n2_1" target="n2_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n2_3" value="¿Las 3 nuevas&lt;br&gt;mejoran el AUC&lt;br&gt;en 2025?&lt;br&gt;(Wilcoxon)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="215" y="243" width="172" height="100" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;strokeWidth=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n2_2" target="n2_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n2_4" value="&lt;b&gt;29 variables&lt;/b&gt;&lt;br&gt;Entran las 3 nuevas (p = 0,0005)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=4;fontSize=11;fontColor=#1F2937;strokeColor=#374151;fillColor=#FFFFFF;strokeWidth=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="215" y="359" width="172" height="52" as="geometry"/></mxCell><mxCell id="e7" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=5;strokeColor=#374151;strokeWidth=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n2_3" target="n2_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lane3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9CA3AF;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="404" y="8" width="186" height="458" as="geometry"/></mxCell><mxCell id="head3" value="&lt;b&gt;Fase 3 · Sección 3.3&lt;/b&gt;&lt;br&gt;Diseño de validación y control de la fuga de información" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;fontSize=11;fontColor=#FFFFFF;fillColor=#1F2937;strokeColor=#1F2937;" vertex="1" parent="1"><mxGeometry x